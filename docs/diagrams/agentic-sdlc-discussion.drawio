  </diagram>

  <diagram id="discussion" name="4 - Evolution and discussion">
    <mxGraphModel dx="1654" dy="1169" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="d0"/>
        <mxCell id="d1" parent="d0"/>
        <mxCell id="dtitle" value="Evolution and discussion map" style="text;html=1;fontSize=28;fontStyle=1;align=left;fontColor=#172B4D;" vertex="1" parent="d1"><mxGeometry x="40" y="25" width="1000" height="45" as="geometry"/></mxCell>
        <mxCell id="dsub" value="The older py-moov package is the documented baseline. The ticketing repository is the current experiment and has added stronger autonomy, state, review, and evidence controls." style="text;html=1;fontSize=15;align=left;fontColor=#5E6C84;" vertex="1" parent="d1"><mxGeometry x="40" y="70" width="1450" height="40" as="geometry"/></mxCell>

        <mxCell id="baseline" value="DOCUMENTED BASELINE&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;py-moov.sdlc-demo&lt;br&gt;&lt;br&gt;Jira + Confluence tracker&lt;br&gt;human gates 1 to 4&lt;br&gt;manual invocation&lt;br&gt;single configured model per stage&lt;br&gt;repo + GitHub for delivery&lt;br&gt;thread markers for memory&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F5F7;strokeColor=#6B778C;fontColor=#344563;fontSize=17;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="80" y="160" width="340" height="300" as="geometry"/></mxCell>
        <mxCell id="current" value="CURRENT EXPERIMENT&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;ticketing_system + sdlc-board&lt;br&gt;&lt;br&gt;local FNS vault tracker&lt;br&gt;current defaults: G1 human, G2 to G4 autonomous&lt;br&gt;orchestrator plus specialist agents&lt;br&gt;cross-model plan and code review&lt;br&gt;optional A/B stage experiments&lt;br&gt;measured transition log + retros&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE8FF;strokeColor=#4C78A8;strokeWidth=3;fontColor=#17365D;fontSize=17;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="655" y="145" width="385" height="330" as="geometry"/></mxCell>
        <mxCell id="possible" value="POSSIBLE NEXT ITERATION&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Discussion, not current behavior&lt;br&gt;&lt;br&gt;per-gate mode and threshold&lt;br&gt;calibrated confidence evidence&lt;br&gt;policy for autonomous overrides&lt;br&gt;cost and latency budgets&lt;br&gt;health checks for state and review&lt;br&gt;selected event automation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#D79B00;fontColor=#5F4300;fontSize=17;fontStyle=1;dashed=1;" vertex="1" parent="d1"><mxGeometry x="1260" y="160" width="320" height="300" as="geometry"/></mxCell>
        <mxCell id="evolve1" value="adapted and tested" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4C78A8;strokeWidth=3;endArrow=block;endFill=1;fontSize=13;" edge="1" parent="d1" source="baseline" target="current"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="evolve2" value="decide what to test next" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D79B00;strokeWidth=2;endArrow=block;endFill=1;dashed=1;fontSize=13;" edge="1" parent="d1" source="current" target="possible"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="qtitle" value="Questions worth putting on the table" style="text;html=1;fontSize=22;fontStyle=1;align=left;fontColor=#172B4D;" vertex="1" parent="d1"><mxGeometry x="70" y="525" width="700" height="40" as="geometry"/></mxCell>
        <mxCell id="q1" value="GATE POLICY&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Which mode belongs on each gate?&lt;br&gt;What evidence contributes to confidence?&lt;br&gt;How is the threshold calibrated over time?&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#D79B00;fontColor=#5F4300;fontSize=15;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="70" y="590" width="350" height="155" as="geometry"/></mxCell>
        <mxCell id="q2" value="MODEL ROUTING&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Are roles assigned by measured strength?&lt;br&gt;When is A/B worth the extra cost?&lt;br&gt;How do we detect a failed or empty review?&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EDFF;strokeColor=#845EC2;fontColor=#402060;fontSize=15;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="455" y="590" width="350" height="155" as="geometry"/></mxCell>
        <mxCell id="q3" value="STATE + RECOVERY&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Is the vault the durable system of record?&lt;br&gt;How much offline work is acceptable?&lt;br&gt;Which gaps need automatic reconciliation?&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECF8F1;strokeColor=#3A8D5D;fontColor=#245B3D;fontSize=15;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="840" y="590" width="350" height="155" as="geometry"/></mxCell>
        <mxCell id="q4" value="EVIDENCE QUALITY&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Which tests can actually fail?&lt;br&gt;Where do browser and mutation checks belong?&lt;br&gt;What proves the gate ran on the right tree?&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4C78A8;fontColor=#17365D;fontSize=15;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="1225" y="590" width="350" height="155" as="geometry"/></mxCell>
        <mxCell id="q5" value="FLOW EFFICIENCY&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Where does work actually wait?&lt;br&gt;Are plan and review loops bounded well?&lt;br&gt;Which checks prevent rework versus add ceremony?&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4C78A8;fontColor=#17365D;fontSize=15;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="70" y="790" width="350" height="155" as="geometry"/></mxCell>
        <mxCell id="q6" value="LEARNING LOOP&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Do retros produce concrete process edits?&lt;br&gt;When does a learning become an ADR, test,&lt;br&gt;repo rule, or skill rule?&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECF8F1;strokeColor=#3A8D5D;fontColor=#245B3D;fontSize=15;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="455" y="790" width="350" height="155" as="geometry"/></mxCell>
        <mxCell id="q7" value="SCALING THE BOARD&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;What happens with several projects and agents?&lt;br&gt;Where are the real WIP limits?&lt;br&gt;Does one local writer remain sufficient?&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F5F7;strokeColor=#6B778C;fontColor=#344563;fontSize=15;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="840" y="790" width="350" height="155" as="geometry"/></mxCell>
        <mxCell id="q8" value="AUTOMATION BOUNDARY&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Which events should wake an agent?&lt;br&gt;Which transitions must remain deliberate?&lt;br&gt;How do we avoid two writers racing?&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#D79B00;fontColor=#5F4300;fontSize=15;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="1225" y="790" width="350" height="155" as="geometry"/></mxCell>

        <mxCell id="decision" value="Suggested meeting outcome&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Pick one hypothesis to test next. Name the observable result, the cost ceiling, and the rule that would change if the result is convincing.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2F2;strokeColor=#C74440;fontColor=#7A1F1C;fontSize=15;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="410" y="1000" width="830" height="90" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
