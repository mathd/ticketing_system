<mxfile host="app.diagrams.net" modified="2026-09-03T12:00:00.000Z" agent="Codex" version="24.7.17" type="device" compressed="false">
  <diagram id="flow" name="1 - Current lifecycle">
    <mxGraphModel dx="1654" dy="1169" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title1" value="Ticket lifecycle with configurable gates" style="text;html=1;fontSize=28;fontStyle=1;align=left;verticalAlign=middle;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="900" height="45" as="geometry"/></mxCell>
        <mxCell id="subtitle1" value="The states stay fixed. Each gate can wait for a human, decide from confidence, or run autonomously." style="text;html=1;fontSize=15;align=left;verticalAlign=middle;fontColor=#5E6C84;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="900" height="30" as="geometry"/></mxCell>
        <mxCell id="gatePolicy" value="PER-GATE POLICY&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;human | confidence-assisted | autonomous&lt;br&gt;current defaults: G1 human, G2–G4 autonomous&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F5F7;strokeColor=#6B778C;fontColor=#344563;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1080" y="25" width="500" height="72" as="geometry"/></mxCell>

        <mxCell id="laneHuman" value="HUMAN / PO (OPTIONAL)" style="swimlane;html=1;horizontal=0;startSize=34;rounded=1;fillColor=#FFF7E6;strokeColor=#E0A100;fontColor=#7A4D00;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="1570" height="150" as="geometry"/></mxCell>
        <mxCell id="laneOrch" value="ORCHESTRATOR" style="swimlane;html=1;horizontal=0;startSize=34;rounded=1;fillColor=#EAF2FF;strokeColor=#4C78A8;fontColor=#244A73;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="285" width="1570" height="240" as="geometry"/></mxCell>
        <mxCell id="laneAgents" value="SPECIALIST AGENTS" style="swimlane;html=1;horizontal=0;startSize=34;rounded=1;fillColor=#F4EDFF;strokeColor=#845EC2;fontColor=#4C2B78;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="1570" height="190" as="geometry"/></mxCell>
        <mxCell id="laneEvidence" value="CODE + EVIDENCE" style="swimlane;html=1;horizontal=0;startSize=34;rounded=1;fillColor=#ECF8F1;strokeColor=#3A8D5D;fontColor=#245B3D;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="745" width="1570" height="180" as="geometry"/></mxCell>

        <mxCell id="hShape" value="Shape the work&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Resolve product decisions&lt;br&gt;and set priority&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE8B3;strokeColor=#D79B00;fontColor=#5F4300;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="95" y="157" width="190" height="80" as="geometry"/></mxCell>
        <mxCell id="g1" value="GATE 1&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Priority&lt;br&gt;current: human&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFD66B;strokeColor=#B77900;fontColor=#5F4300;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="310" y="148" width="130" height="98" as="geometry"/></mxCell>
        <mxCell id="hPlan" value="GATE 2 · PLAN&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;current: autonomous&lt;br&gt;human on policy escalation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1CC;strokeColor=#D79B00;fontColor=#5F4300;fontSize=13;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="595" y="157" width="190" height="80" as="geometry"/></mxCell>
        <mxCell id="hReview" value="GATE 3 · REVIEW + MERGE&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;current: autonomous&lt;br&gt;human on policy escalation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1CC;strokeColor=#D79B00;fontColor=#5F4300;fontSize=13;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1010" y="157" width="210" height="80" as="geometry"/></mxCell>
        <mxCell id="hAccept" value="GATE 4 · ACCEPTANCE&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;current: autonomous&lt;br&gt;human on policy escalation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1CC;strokeColor=#D79B00;fontColor=#5F4300;fontSize=13;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1290" y="157" width="210" height="80" as="geometry"/></mxCell>

        <mxCell id="backlog" value="1. BACKLOG&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Idea → brief → PRD&lt;br&gt;decompose, COS, DoR&lt;br&gt;context memo + spikes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE8FF;strokeColor=#4C78A8;fontColor=#17365D;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="335" width="205" height="130" as="geometry"/></mxCell>
        <mxCell id="ready" value="2. READY&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Approved queue&lt;br&gt;zero open blockers&lt;br&gt;claim + branch&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE8FF;strokeColor=#4C78A8;fontColor=#17365D;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="335" y="335" width="190" height="130" as="geometry"/></mxCell>
        <mxCell id="planning" value="3. PLANNING&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Read ticket, code, ADRs,&lt;br&gt;governing tests&lt;br&gt;choose a test seam&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE8FF;strokeColor=#4C78A8;fontColor=#17365D;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="565" y="335" width="220" height="130" as="geometry"/></mxCell>
        <mxCell id="building" value="4. BUILDING&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;TDD, commit, local gate&lt;br&gt;push, PR, review fixes&lt;br&gt;review guide&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE8FF;strokeColor=#4C78A8;fontColor=#17365D;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="830" y="335" width="235" height="130" as="geometry"/></mxCell>
        <mxCell id="poreview" value="5. PO REVIEW&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Merged result&lt;br&gt;validate each COS&lt;br&gt;record evidence&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE8FF;strokeColor=#4C78A8;fontColor=#17365D;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1110" y="335" width="210" height="130" as="geometry"/></mxCell>
        <mxCell id="done" value="6. DONE&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Metrics + retro&lt;br&gt;promote learnings&lt;br&gt;delete branch&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BFE8CF;strokeColor=#2E7D4F;fontColor=#1E5939;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1360" y="335" width="190" height="130" as="geometry"/></mxCell>

        <mxCell id="planner" value="Plan drafter&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;gpt-5.6-sol&lt;br&gt;read-only proposal&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8DCFF;strokeColor=#845EC2;fontColor=#402060;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="525" y="585" width="180" height="95" as="geometry"/></mxCell>
        <mxCell id="planReview" value="Plan reviewer&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;main agent&lt;br&gt;verify seams + pre-mortem&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8DCFF;strokeColor=#845EC2;fontColor=#402060;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="720" y="585" width="195" height="95" as="geometry"/></mxCell>
        <mxCell id="implementer" value="Implementer&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;gemini-3.8-flash-high&lt;br&gt;one writer, one branch&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8DCFF;strokeColor=#845EC2;fontColor=#402060;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="930" y="585" width="195" height="95" as="geometry"/></mxCell>
        <mxCell id="codeReview" value="Code reviewer&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;gpt-5.6-sol&lt;br&gt;diff-only adversarial review&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8DCFF;strokeColor=#845EC2;fontColor=#402060;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1140" y="585" width="205" height="95" as="geometry"/></mxCell>
        <mxCell id="agentRule" value="Load-bearing rule&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Author ≠ reviewer&lt;br&gt;for both plan and code&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2F2;strokeColor=#C74440;fontColor=#7A1F1C;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1390" y="585" width="170" height="95" as="geometry"/></mxCell>

        <mxCell id="eContext" value="Ticket thread is memory&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;status + label + marker comments&lt;br&gt;resume from recorded state&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3E5;strokeColor=#3A8D5D;fontColor=#245B3D;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="95" y="790" width="240" height="90" as="geometry"/></mxCell>
        <mxCell id="eGate" value="Gate evidence&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;committed tree → make check&lt;br&gt;.gate.verdict is authoritative&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3E5;strokeColor=#3A8D5D;fontColor=#245B3D;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="610" y="790" width="245" height="90" as="geometry"/></mxCell>
        <mxCell id="eBrowser" value="Browser evidence when UI writes change&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;make browser submits the real form&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3E5;strokeColor=#3A8D5D;fontColor=#245B3D;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="880" y="790" width="270" height="90" as="geometry"/></mxCell>
        <mxCell id="eReview" value="Review evidence&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;triage every finding&lt;br&gt;second pass after non-trivial fixes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3E5;strokeColor=#3A8D5D;fontColor=#245B3D;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1175" y="790" width="245" height="90" as="geometry"/></mxCell>
        <mxCell id="eClose" value="Closeout evidence&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;durations, diff, human wait,&lt;br&gt;overrides, learnings, retro&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3E5;strokeColor=#3A8D5D;fontColor=#245B3D;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1440" y="790" width="140" height="90" as="geometry"/></mxCell>

        <mxCell id="blocked" value="BLOCKED is transversal. Keep the prior pipeline label, stop work, and resume in context after the blocker clears." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6E6;strokeColor=#C74440;fontColor=#7A1F1C;fontSize=14;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="300" y="960" width="1010" height="55" as="geometry"/></mxCell>
        <mxCell id="correction" value="CONFIDENCE-ASSISTED GATE&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;auto-proceed above a calibrated threshold and only when no stop condition fires&lt;br&gt;otherwise set needs:human and preserve the evidence behind the escalation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F5F7;strokeColor=#6B778C;fontColor=#344563;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="495" y="1035" width="620" height="90" as="geometry"/></mxCell>

        <mxCell id="f1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4C78A8;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="backlog" target="ready"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4C78A8;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="ready" target="planning"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4C78A8;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="planning" target="building"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4C78A8;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="building" target="poreview"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4C78A8;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="poreview" target="done"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fp1" value="draft" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#845EC2;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="planning" target="planner"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fp2" value="critique" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#845EC2;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="planner" target="planReview"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fb1" value="approved plan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#845EC2;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="building" target="implementer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fb2" value="PR diff" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#845EC2;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="implementer" target="codeReview"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="hg1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D79B00;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="g1" target="ready"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="hg2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D79B00;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="hPlan" target="building"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="hg3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D79B00;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="hReview" target="poreview"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="hg4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D79B00;endArrow=block;endFill=1;" edge="1" parent="1" source="hAccept" target="done"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="agents" name="2 - Multi-agent workflow">
    <mxGraphModel dx="1654" dy="1169" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="a0"/>
        <mxCell id="a1" parent="a0"/>
        <mxCell id="atitle" value="Multi-agent workflow: one accountable orchestrator" style="text;html=1;fontSize=28;fontStyle=1;align=left;fontColor=#172B4D;" vertex="1" parent="a1"><mxGeometry x="40" y="25" width="1000" height="45" as="geometry"/></mxCell>
        <mxCell id="asub" value="Specialists produce bounded artifacts. The orchestrator owns context, verification, board state, and gate escalation to the human." style="text;html=1;fontSize=15;align=left;fontColor=#5E6C84;" vertex="1" parent="a1"><mxGeometry x="40" y="70" width="1400" height="32" as="geometry"/></mxCell>

        <mxCell id="human" value="Human / owner&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Product intent&lt;br&gt;steering&lt;br&gt;selected or escalated gates&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFE8B3;strokeColor=#D79B00;fontColor=#5F4300;fontSize=16;fontStyle=1;" vertex="1" parent="a1"><mxGeometry x="80" y="390" width="190" height="190" as="geometry"/></mxCell>
        <mxCell id="orch" value="ORCHESTRATOR&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;&lt;br&gt;Reads actual board state&lt;br&gt;rebuilds context from markers&lt;br&gt;briefs each worker&lt;br&gt;verifies claims and findings&lt;br&gt;triages review output&lt;br&gt;moves labels and statuses&lt;br&gt;records decisions and metrics&lt;br&gt;owns the final outcome&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE8FF;strokeColor=#4C78A8;strokeWidth=3;fontColor=#17365D;fontSize=18;fontStyle=1;" vertex="1" parent="a1"><mxGeometry x="590" y="300" width="360" height="370" as="geometry"/></mxCell>

        <mxCell id="planAgent" value="PLAN DRAFTER&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;gpt-5.6-sol&lt;br&gt;&lt;br&gt;Input&lt;br&gt;ticket + context memo&lt;br&gt;ADRs + governing tests&lt;br&gt;real code&lt;br&gt;&lt;br&gt;Output&lt;br&gt;proposal, DoD, files,&lt;br&gt;test seam, risks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8DCFF;strokeColor=#845EC2;fontColor=#402060;fontSize=15;fontStyle=1;" vertex="1" parent="a1"><mxGeometry x="1080" y="125" width="240" height="260" as="geometry"/></mxCell>
        <mxCell id="planCritic" value="PLAN REVIEWER&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;main agent&lt;br&gt;&lt;br&gt;Challenges the proposal&lt;br&gt;checks exact seams and wire facts&lt;br&gt;runs a pre-mortem&lt;br&gt;returns accept / amend / reject&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8DCFF;strokeColor=#845EC2;fontColor=#402060;fontSize=15;fontStyle=1;" vertex="1" parent="a1"><mxGeometry x="1335" y="180" width="245" height="205" as="geometry"/></mxCell>
        <mxCell id="implAgent" value="IMPLEMENTER&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;gemini-3.8-flash-high&lt;br&gt;&lt;br&gt;Input&lt;br&gt;approved plan&lt;br&gt;&lt;br&gt;Output&lt;br&gt;tests observed red&lt;br&gt;implementation + commits&lt;br&gt;local gate claim + PR&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8DCFF;strokeColor=#845EC2;fontColor=#402060;fontSize=15;fontStyle=1;" vertex="1" parent="a1"><mxGeometry x="1080" y="610" width="240" height="240" as="geometry"/></mxCell>
        <mxCell id="reviewAgent" value="CODE REVIEWER&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;gpt-5.6-sol&lt;br&gt;&lt;br&gt;Input&lt;br&gt;branch diff vs base only&lt;br&gt;&lt;br&gt;Output&lt;br&gt;conclusive verdict&lt;br&gt;code-cited findings&lt;br&gt;second pass on fix diff&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8DCFF;strokeColor=#845EC2;fontColor=#402060;fontSize=15;fontStyle=1;" vertex="1" parent="a1"><mxGeometry x="1335" y="610" width="245" height="240" as="geometry"/></mxCell>

        <mxCell id="artifact1" value="Plan draft" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFFFFF;strokeColor=#6B778C;fontColor=#344563;fontSize=12;" vertex="1" parent="a1"><mxGeometry x="990" y="420" width="130" height="75" as="geometry"/></mxCell>
        <mxCell id="artifact2" value="Plan delta&lt;br&gt;+ decisions" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFFFFF;strokeColor=#6B778C;fontColor=#344563;fontSize=12;" vertex="1" parent="a1"><mxGeometry x="1160" y="440" width="140" height="75" as="geometry"/></mxCell>
        <mxCell id="artifact3" value="Committed&lt;br&gt;PR diff" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFFFFF;strokeColor=#6B778C;fontColor=#344563;fontSize=12;" vertex="1" parent="a1"><mxGeometry x="990" y="890" width="130" height="75" as="geometry"/></mxCell>
        <mxCell id="artifact4" value="Verified&lt;br&gt;finding set" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFFFFF;strokeColor=#6B778C;fontColor=#344563;fontSize=12;" vertex="1" parent="a1"><mxGeometry x="1335" y="890" width="145" height="75" as="geometry"/></mxCell>

        <mxCell id="invariants" value="Non-negotiable boundaries" style="swimlane;html=1;rounded=1;startSize=34;fillColor=#FFF2F2;strokeColor=#C74440;fontColor=#7A1F1C;fontSize=15;fontStyle=1;" vertex="1" parent="a1"><mxGeometry x="70" y="760" width="780" height="300" as="geometry"/></mxCell>
        <mxCell id="inv1" value="1. Reviewer never authors the work it reviews." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C74440;fontColor=#7A1F1C;fontSize=13;" vertex="1" parent="a1"><mxGeometry x="105" y="815" width="335" height="55" as="geometry"/></mxCell>
        <mxCell id="inv2" value="2. Gate mode is explicit per gate. Confidence below threshold escalates instead of guessing." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C74440;fontColor=#7A1F1C;fontSize=13;" vertex="1" parent="a1"><mxGeometry x="465" y="815" width="350" height="55" as="geometry"/></mxCell>
        <mxCell id="inv3" value="3. Implementation has one writer and one ticket branch. The TDD loop is sequential." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C74440;fontColor=#7A1F1C;fontSize=13;" vertex="1" parent="a1"><mxGeometry x="105" y="895" width="335" height="55" as="geometry"/></mxCell>
        <mxCell id="inv4" value="4. A worker's green gate or review claim is evidence to verify, not authority." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C74440;fontColor=#7A1F1C;fontSize=13;" vertex="1" parent="a1"><mxGeometry x="465" y="895" width="350" height="55" as="geometry"/></mxCell>
        <mxCell id="inv5" value="5. Every finding is fixed, deferred to a ticket, or rejected with a reason." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C74440;fontColor=#7A1F1C;fontSize=13;" vertex="1" parent="a1"><mxGeometry x="105" y="975" width="335" height="55" as="geometry"/></mxCell>
        <mxCell id="inv6" value="6. Conversation memory never substitutes for the ticket thread." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C74440;fontColor=#7A1F1C;fontSize=13;" vertex="1" parent="a1"><mxGeometry x="465" y="975" width="350" height="55" as="geometry"/></mxCell>

        <mxCell id="ah1" value="intent + decisions" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D79B00;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="a1" source="human" target="orch"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ah2" value="questions + evidence" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D79B00;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="a1" source="orch" target="human"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ap1" value="bounded brief" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#845EC2;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="a1" source="orch" target="planAgent"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ap2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#845EC2;endArrow=block;endFill=1;fontSize=12;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="a1" source="planAgent" target="artifact1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ap3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#845EC2;endArrow=block;endFill=1;fontSize=12;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="a1" source="planCritic" target="artifact2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ai1" value="approved plan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#845EC2;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="a1" source="orch" target="implAgent"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ai2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#845EC2;endArrow=block;endFill=1;fontSize=12;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="a1" source="implAgent" target="artifact3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ar1" value="diff-only brief" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#845EC2;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="a1" source="orch" target="reviewAgent"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ar2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#845EC2;endArrow=block;endFill=1;fontSize=12;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="a1" source="reviewAgent" target="artifact4"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="systems" name="3 - State and evidence architecture">
    <mxGraphModel dx="1654" dy="1169" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="s0"/>
        <mxCell id="s1" parent="s0"/>
        <mxCell id="stitle" value="State, code, and evidence architecture" style="text;html=1;fontSize=28;fontStyle=1;align=left;fontColor=#172B4D;" vertex="1" parent="s1"><mxGeometry x="40" y="25" width="1000" height="45" as="geometry"/></mxCell>
        <mxCell id="ssub" value="The board records work state. GitHub records code state. The orchestrator joins them through the ticket key and stage comments." style="text;html=1;fontSize=15;align=left;fontColor=#5E6C84;" vertex="1" parent="s1"><mxGeometry x="40" y="70" width="1400" height="32" as="geometry"/></mxCell>

        <mxCell id="clients" value="ACTORS" style="swimlane;html=1;rounded=1;startSize=34;fillColor=#FFF7E6;strokeColor=#D79B00;fontColor=#5F4300;fontSize=14;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="50" y="145" width="250" height="350" as="geometry"/></mxCell>
        <mxCell id="browser" value="Human&lt;br&gt;board.html&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;drag + edit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE8B3;strokeColor=#D79B00;fontColor=#5F4300;fontSize=14;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="85" y="205" width="180" height="95" as="geometry"/></mxCell>
        <mxCell id="agentClient" value="Orchestrator&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;GET /board&lt;br&gt;POST /ticket&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE8FF;strokeColor=#4C78A8;fontColor=#17365D;fontSize=14;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="85" y="335" width="180" height="105" as="geometry"/></mxCell>

        <mxCell id="boardBoundary" value="LOCAL SDLC BOARD REPO" style="swimlane;html=1;rounded=1;startSize=34;fillColor=#F4F5F7;strokeColor=#6B778C;fontColor=#344563;fontSize=14;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="365" y="120" width="455" height="470" as="geometry"/></mxCell>
        <mxCell id="server" value="server.py&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;localhost only&lt;br&gt;workflow validation&lt;br&gt;status compare-and-swap&lt;br&gt;single transition-log writer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B778C;fontColor=#344563;fontSize=15;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="410" y="190" width="180" height="150" as="geometry"/></mxCell>
        <mxCell id="mirror" value="In-memory + disk mirror&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;read model&lt;br&gt;survives FNS outage&lt;br&gt;server mtime watermark&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B778C;fontColor=#344563;fontSize=14;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="610" y="190" width="170" height="150" as="geometry"/></mxCell>
        <mxCell id="routes" value="Board routes&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;/board /ticket /archive&lt;br&gt;/history /metrics /vaults&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B778C;fontColor=#344563;fontSize=13;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="410" y="390" width="370" height="95" as="geometry"/></mxCell>
        <mxCell id="cas" value="Write invariant&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;_rev is required and equals&lt;br&gt;the status being moved from&lt;br&gt;409 means re-read and re-apply&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2F2;strokeColor=#C74440;fontColor=#7A1F1C;fontSize=13;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="455" y="510" width="280" height="60" as="geometry"/></mxCell>

        <mxCell id="fnsBoundary" value="FAST NOTE SYNC VAULT: SOURCE OF TRUTH" style="swimlane;html=1;rounded=1;startSize=34;fillColor=#ECF8F1;strokeColor=#3A8D5D;fontColor=#245B3D;fontSize=14;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="895" y="120" width="700" height="470" as="geometry"/></mxCell>
        <mxCell id="tickets" value="tickets/TKT-N.md&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;status, labels, assignment,&lt;br&gt;COS, readiness, context,&lt;br&gt;marker comments, PR&lt;/font&gt;" style="shape=folder;tabWidth=50;tabHeight=18;tabPosition=left;html=1;whiteSpace=wrap;fillColor=#DDF3E5;strokeColor=#3A8D5D;fontColor=#245B3D;fontSize=14;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="945" y="190" width="200" height="145" as="geometry"/></mxCell>
        <mxCell id="boardConfig" value="_board/config.md&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;statuses, transitions,&lt;br&gt;WIP, schema&lt;/font&gt;" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#DDF3E5;strokeColor=#3A8D5D;fontColor=#245B3D;fontSize=14;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="1180" y="190" width="175" height="125" as="geometry"/></mxCell>
        <mxCell id="transitions" value="_log/transitions.md&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;append-only timing&lt;br&gt;role + model + effort&lt;br&gt;history + metrics source&lt;/font&gt;" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#DDF3E5;strokeColor=#3A8D5D;fontColor=#245B3D;fontSize=14;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="1390" y="190" width="170" height="145" as="geometry"/></mxCell>
        <mxCell id="archive" value="archive/TKT-N.md&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;closed work remains searchable&lt;/font&gt;" style="shape=folder;tabWidth=50;tabHeight=18;tabPosition=left;html=1;whiteSpace=wrap;fillColor=#DDF3E5;strokeColor=#3A8D5D;fontColor=#245B3D;fontSize=13;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="1180" y="390" width="175" height="105" as="geometry"/></mxCell>
        <mxCell id="fnsRules" value="Measured protocol facts&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;REST baseHash is not enforced&lt;br&gt;concurrent appends lose data&lt;br&gt;WebSocket sync is pull-based&lt;br&gt;contentHash is recomputed locally&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2F2;strokeColor=#C74440;fontColor=#7A1F1C;fontSize=13;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="945" y="475" width="615" height="95" as="geometry"/></mxCell>

        <mxCell id="repoBoundary" value="PROJECT REPO" style="swimlane;html=1;rounded=1;startSize=34;fillColor=#EAF2FF;strokeColor=#4C78A8;fontColor=#17365D;fontSize=14;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="50" y="650" width="850" height="395" as="geometry"/></mxCell>
        <mxCell id="config" value=".claude/sdlc.config.json&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;tracker, gates, models,&lt;br&gt;repo, local gate, registry&lt;/font&gt;" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFFFFF;strokeColor=#4C78A8;fontColor=#17365D;fontSize=13;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="100" y="720" width="210" height="125" as="geometry"/></mxCell>
        <mxCell id="skill" value="sdlc-ticket skill&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;state machine&lt;br&gt;gates + invariants&lt;br&gt;stage instructions&lt;/font&gt;" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFFFFF;strokeColor=#4C78A8;fontColor=#17365D;fontSize=13;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="350" y="720" width="190" height="125" as="geometry"/></mxCell>
        <mxCell id="decisions" value="docs/adr + governing tests&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;constraints for planning&lt;br&gt;revalidated at claim time&lt;/font&gt;" style="shape=folder;tabWidth=50;tabHeight=18;tabPosition=left;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#4C78A8;fontColor=#17365D;fontSize=13;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="580" y="720" width="260" height="125" as="geometry"/></mxCell>
        <mxCell id="code" value="Ticket branch + tests + generated code&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;committed before gate&lt;br&gt;never edit while gate runs&lt;/font&gt;" style="shape=folder;tabWidth=50;tabHeight=18;tabPosition=left;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#4C78A8;fontColor=#17365D;fontSize=13;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="100" y="900" width="320" height="105" as="geometry"/></mxCell>
        <mxCell id="gate" value="make check → .gate.verdict&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;lint + tests + build + smoke&lt;br&gt;browser submit is separate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3E5;strokeColor=#3A8D5D;fontColor=#245B3D;fontSize=13;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="470" y="900" width="320" height="105" as="geometry"/></mxCell>

        <mxCell id="githubBoundary" value="GITHUB / CODE DELIVERY" style="swimlane;html=1;rounded=1;startSize=34;fillColor=#F4EDFF;strokeColor=#845EC2;fontColor=#402060;fontSize=14;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="970" y="650" width="625" height="260" as="geometry"/></mxCell>
        <mxCell id="pr" value="Pull request&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;ticket key in title/body&lt;br&gt;review guide + diff&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8DCFF;strokeColor=#845EC2;fontColor=#402060;fontSize=14;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="1020" y="720" width="210" height="115" as="geometry"/></mxCell>
        <mxCell id="ci" value="CI + merge&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;same gate as local&lt;br&gt;squash merge&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8DCFF;strokeColor=#845EC2;fontColor=#402060;fontSize=14;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="1280" y="720" width="250" height="115" as="geometry"/></mxCell>
        <mxCell id="archiveJob" value="Scheduled pull&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;FNS → sdlc-state&lt;br&gt;read-only rollback archive&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F5F7;strokeColor=#6B778C;fontColor=#344563;fontSize=13;fontStyle=1;dashed=1;" vertex="1" parent="s1"><mxGeometry x="1090" y="960" width="350" height="90" as="geometry"/></mxCell>

        <mxCell id="sc1" value="read / write" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B778C;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="s1" source="browser" target="server"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sc2" value="read / write" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B778C;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="s1" source="agentClient" target="server"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sm1" value="serves reads" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B778C;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="s1" source="mirror" target="server"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sf1" value="REST write" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3A8D5D;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="s1" source="server" target="tickets"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="150"/><mxPoint x="1045" y="150"/></Array></mxGeometry></mxCell>
        <mxCell id="sf2" value="serialized append" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3A8D5D;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="s1" source="server" target="transitions"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="365"/><mxPoint x="1475" y="365"/></Array></mxGeometry></mxCell>
        <mxCell id="sf3" value="WebSocket sync" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3A8D5D;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="s1" source="tickets" target="mirror"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1045" y="385"/><mxPoint x="695" y="385"/></Array></mxGeometry></mxCell>
        <mxCell id="sr1" value="rules + routing" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4C78A8;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="s1" source="config" target="agentClient"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sr2" value="working tree" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4C78A8;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="s1" source="code" target="gate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sg1" value="push + PR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#845EC2;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="s1" source="code" target="pr"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sg2" value="check + merge" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#845EC2;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="s1" source="pr" target="ci"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sa1" value="every 15 min" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B778C;endArrow=block;endFill=1;dashed=1;fontSize=11;" edge="1" parent="s1" source="tickets" target="archiveJob"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
