{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  // test/ rather than src/: the config test reads the effective compiler config
  // through node:child_process, and putting it in the app project would mean
  // adding "node" to the app's types — which makes `process` and `Buffer` legal
  // in every BROWSER module under src/, so code that cannot run in a browser
  // would typecheck cleanly and fail only at the live gate (TKT-302 ai-review
  // [medium]). The app's environment checking stays narrow; the Node-shaped test
  // lives in the Node-shaped project.
  "include": ["vite.config.ts", "test"]
}
