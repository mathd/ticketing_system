# Smoke-only packaging image: serves the host-built dist (make build-ts)
# instead of running pnpm install + vite inside Docker. The hermetic build
# stays in web/scanner/Dockerfile. Build context = repo root.
FROM nginx:alpine
COPY web/scanner/nginx.conf /etc/nginx/conf.d/default.conf
COPY web/scanner/dist /usr/share/nginx/html/scanner
