---
// Event detail — one aggregated read carrying prices (single-source rule:
// no independently-cached API copy is fetched browser-side), minutes tier.
import Layout from '../../../layouts/Layout.astro';
import { getPublicEvent, type PublicEventDetail } from '../../../lib/api';
import { UpstreamError } from '../../../lib/cache';
import { UI_STRINGS, isLocale } from '../../../lib/locales';
import PerformanceCard from '../../../components/PerformanceCard.astro';

const { locale, eventId } = Astro.params;
if (!locale || !isLocale(locale) || !eventId) {
  return new Response(null, { status: 404 });
}
const t = UI_STRINGS[locale];

let event: PublicEventDetail;
try {
  event = await getPublicEvent(Astro, locale, eventId);
} catch (err) {
  if (err instanceof UpstreamError && (err.status === 404 || err.status === 400)) {
    return new Response(null, { status: 404 });
  }
  return new Response('Service unavailable', { status: 503 });
}
const byId = new Map(event.performances.map((performance) => [performance.id, performance]));
const grouped = new Set(event.series.flatMap((series) => series.performance_ids));
---

<Layout locale={locale} title={event.name}>
  <a class="back" href={`/${locale}/events`}>← {t.backToEvents}</a>
  <h1>{event.name}</h1>
  {event.description && <p class="description">{event.description}</p>}
  {
    event.series.map((series) => (
      <section class="series">
        <h2>{series.name}</h2>
        {series.performance_ids.map((id) => byId.get(id)).filter((perf) => perf !== undefined).map((perf) => <PerformanceCard performance={perf} organizerId={event.organizer_id} locale={locale} venueLabel={t.venue} ticketsLabel={t.tickets} />)}
      </section>
    ))
  }
  {event.performances.filter((perf) => !grouped.has(perf.id)).map((perf) => <PerformanceCard performance={perf} organizerId={event.organizer_id} locale={locale} venueLabel={t.venue} ticketsLabel={t.tickets} />)}
</Layout>

<style>
  .back {
    display: inline-block;
    margin-bottom: 1rem;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.9rem;
  }
  .back:hover {
    color: var(--accent);
  }
  h1 {
    font-size: 1.6rem;
    margin: 0 0 0.3rem;
  }
  .description {
    color: var(--muted);
    margin: 0 0 1.4rem;
  }
  .series { border-left: 3px solid var(--accent); padding-left: 1rem; margin-bottom: 1.5rem; }
  .series > h2 { font-size: 1.15rem; margin: 0 0 0.75rem; }
</style>

<style is:global>
  .hold-picker {
    display: grid;
    grid-template-columns: auto 5rem auto 1fr;
    align-items: center;
    gap: 0.65rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .hold-picker label { display: contents; color: var(--muted); font-size: 0.9rem; }
  .hold-picker input {
    width: 5rem;
    padding: 0.45rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    font: inherit;
  }
  .hold-picker button {
    padding: 0.5rem 0.9rem;
    border: 0;
    border-radius: 6px;
    background: var(--accent);
    color: white;
    font: inherit;
    font-weight: 650;
    cursor: pointer;
  }
  .hold-picker button:disabled { opacity: 0.55; cursor: not-allowed; }
  .hold-picker [aria-live] { color: var(--muted); font-size: 0.9rem; }
  .checkout-form { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 0.65rem; align-items: end; }
  .checkout-form label { display: grid; gap: 0.25rem; }
  .checkout-form input, .checkout-form select { padding: 0.45rem; border: 1px solid var(--line); border-radius: 6px; }
  @media (max-width: 36rem) {
    .hold-picker { grid-template-columns: auto 1fr; }
    .hold-picker [aria-live] { grid-column: 1 / -1; }
  }
</style>
