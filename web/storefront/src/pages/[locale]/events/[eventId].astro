---
// Event detail — one aggregated read carrying prices (single-source rule:
// no independently-cached API copy is fetched browser-side), minutes tier.
import Layout from '../../../layouts/Layout.astro';
import { getPublicEvent, type PublicEventDetail } from '../../../lib/api';
import { UpstreamError } from '../../../lib/cache';
import { UI_STRINGS, isLocale } from '../../../lib/locales';
import PerformanceCard from '../../../components/PerformanceCard.astro';

const { locale, eventId } = Astro.params;
if (!locale || !isLocale(locale) || !eventId) {
  return new Response(null, { status: 404 });
}
const t = UI_STRINGS[locale];

let event: PublicEventDetail;
try {
  event = await getPublicEvent(Astro, locale, eventId);
} catch (err) {
  if (err instanceof UpstreamError && (err.status === 404 || err.status === 400)) {
    return new Response(null, { status: 404 });
  }
  return new Response('Service unavailable', { status: 503 });
}
const byId = new Map(event.performances.map((performance) => [performance.id, performance]));
const grouped = new Set(event.series.flatMap((series) => series.performance_ids));
---

<Layout locale={locale} title={event.name}>
  <a class="back" href={`/${locale}/events`}>← {t.backToEvents}</a>
  <h1>{event.name}</h1>
  {event.description && <p class="description">{event.description}</p>}
  {
    event.series.map((series) => (
      <section class="series">
        <h2>{series.name}</h2>
        {series.performance_ids.map((id) => byId.get(id)).filter((perf) => perf !== undefined).map((perf) => <PerformanceCard performance={perf} organizerId={event.organizer_id} locale={locale} venueLabel={t.venue} ticketsLabel={t.tickets} />)}
      </section>
    ))
  }
  {event.performances.filter((perf) => !grouped.has(perf.id)).map((perf) => <PerformanceCard performance={perf} organizerId={event.organizer_id} locale={locale} venueLabel={t.venue} ticketsLabel={t.tickets} />)}
</Layout>

<style>
  .back {
    display: inline-block;
    margin-bottom: 1rem;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.9rem;
  }
  .back:hover {
    color: var(--accent);
  }
  h1 {
    font-size: 1.6rem;
    margin: 0 0 0.3rem;
  }
  .description {
    color: var(--muted);
    margin: 0 0 1.4rem;
  }
  .series { border-left: 3px solid var(--accent); padding-left: 1rem; margin-bottom: 1.5rem; }
  .series > h2 { font-size: 1.15rem; margin: 0 0 0.75rem; }
</style>

<style is:global>
  .hold-picker {
    display: grid;
    grid-template-columns: auto 5rem auto 1fr;
    align-items: center;
    gap: 0.65rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .hold-picker label { display: contents; color: var(--muted); font-size: 0.9rem; }
  .hold-picker input {
    width: 5rem;
    padding: 0.45rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    font: inherit;
  }
  .hold-picker button {
    padding: 0.5rem 0.9rem;
    border: 0;
    border-radius: 6px;
    background: var(--accent);
    color: white;
    font: inherit;
    font-weight: 650;
    cursor: pointer;
  }
  .hold-picker button:disabled { opacity: 0.55; cursor: not-allowed; }
  .hold-picker [aria-live] { color: var(--muted); font-size: 0.9rem; }
  .checkout-form { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 0.65rem; align-items: end; }

  /* Seat picker (TKT-174). The island spans the picker grid: a map is not a form
     control and must not be squeezed into the quantity column. */
  .seat-map { grid-column: 1 / -1; }
  .seat-legend {
    display: flex; flex-wrap: wrap; gap: 0.9rem;
    list-style: none; margin: 0 0 0.9rem; padding: 0;
    color: var(--muted); font-size: 0.85rem;
  }
  .seat-legend li { display: flex; align-items: center; gap: 0.35rem; }
  /* The swatch is redundant on purpose: the state is already in the seat's glyph
     and in its accessible name, so colour is never the only channel (AC1). */
  .seat-swatch {
    display: inline-grid; place-items: center;
    width: 1.15rem; height: 1.15rem; border-radius: 4px;
    border: 1px solid var(--line); font-size: 0.7rem; line-height: 1;
  }
  .seat-swatch.selected { background: var(--accent); border-color: var(--accent); color: #fff; }
  .seat-swatch.taken { background: var(--line); color: var(--muted); }
  .seat-section { margin-bottom: 1rem; }
  .seat-section > h5 {
    font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--muted); margin: 0 0 0.4rem;
  }
  /* Rows scroll horizontally rather than wrapping: a wrapped row is a lie about
     where the seats physically are. Sections stay independently scrollable so
     keyboard focus is never destroyed by virtualization. */
  .seat-row { display: flex; align-items: center; gap: 0.3rem; margin-bottom: 0.3rem; overflow-x: auto; }
  .seat-row-label { width: 1.6rem; flex: none; color: var(--muted); font-size: 0.8rem; }
  /* Scoped under .seat-map deliberately. The picker's buttons live inside
     .hold-picker, whose existing `.hold-picker button` rule is a solid accent block
     — and at specificity (0,1,1) it BEATS a bare `.seat` (0,1,0). Unscoped, every
     free seat rendered in the accent colour, identical to a selected one: the map
     still worked and still read correctly to a screen reader, so no unit test could
     see it. A browser did (TKT-174 verification). Two classes here restore the
     order without touching the GA path's rule. */
  .seat-map .seat {
    flex: none; width: 2rem; height: 2rem;
    border: 1px solid var(--line); border-radius: 5px;
    background: var(--card); color: var(--fg, inherit);
    font: inherit; font-size: 0.8rem; font-weight: 500; line-height: 1;
    cursor: pointer;
  }
  .seat-map .seat.free:hover { border-color: var(--accent); }
  .seat-map .seat.selected { background: var(--accent); border-color: var(--accent); color: #fff; font-weight: 700; }
  .seat-map .seat.taken { background: var(--line); color: var(--muted); cursor: not-allowed; }
  .seat-map .seat:disabled { cursor: not-allowed; }
  /* A visible focus ring is the keyboard user's only feedback that selection moved. */
  .seat-map .seat:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .seat-status, .seat-map-closed, .seat-map-loading, .seat-map-unavailable {
    grid-column: 1 / -1; margin: 0.5rem 0 0; color: var(--muted); font-size: 0.9rem;
  }
  .seat-map-unavailable { color: var(--accent); }
  .checkout-form label { display: grid; gap: 0.25rem; }
  .checkout-form input, .checkout-form select { padding: 0.45rem; border: 1px solid var(--line); border-radius: 6px; }
  @media (max-width: 36rem) {
    .hold-picker { grid-template-columns: auto 1fr; }
    .hold-picker [aria-live] { grid-column: 1 / -1; }
  }
</style>
