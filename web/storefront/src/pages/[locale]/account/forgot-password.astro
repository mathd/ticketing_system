---
// Ask for a password-reset link (TKT-226 / ADR-050).
//
// Anonymous by construction — its entire audience is people who cannot sign in, so
// gate.ts lists it beside register and sign-in. Gating it would redirect a
// locked-out buyer to the form they are locked out of.
//
// The form action is RELATIVE (`action=""` posts to this same URL). An absolute
// action trips Astro's origin handling even same-origin — the second trap TKT-105
// paid for — and the middleware's own origin check runs on this POST too.
import Layout from '../../../layouts/Layout.astro';
import { requestPasswordReset } from '../../../lib/customer-api';
import { UI_STRINGS, isLocale } from '../../../lib/locales';

const locale = Astro.params.locale;
if (!locale || !isLocale(locale)) return new Response('Not found', { status: 404 });
const t = UI_STRINGS[locale];

// `submitted` is set for EVERY well-formed request, known address or not. There is
// deliberately no third state: a page that could render "no such account" would be
// the membership oracle the endpoint is shaped to avoid, rebuilt in HTML.
let submitted = false;
let error: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? '');

  if (!email) {
    // An empty field never reaches commerce, and this is NOT an existence claim —
    // the buyer submitted nothing, which they can see for themselves.
    error = t.credentialsInvalid;
  } else {
    const result = await requestPasswordReset(email);
    // `ok` is 202-vs-outage, never known-vs-unknown. Commerce does not tell this
    // process which it was, which is exactly why it cannot leak.
    if (result.ok) submitted = true;
    else error = t.accountUnavailable;
  }
}
---

<Layout locale={locale} title={t.forgotPassword}>
  <h1>{t.forgotPassword}</h1>
  {
    submitted ? (
      <p class="notice" role="status">{t.resetRequested}</p>
    ) : (
      <>
        <p class="notice">{t.forgotPasswordIntro}</p>
        <form method="post" action="">
          {error && <p class="error" role="alert">{error}</p>}
          <label for="email">{t.email}</label>
          <input id="email" name="email" type="email" autocomplete="username" required />
          <button type="submit">{t.sendResetLink}</button>
        </form>
      </>
    )
  }
  <p><a href={`/${locale}/account/sign-in`}>{t.signInCta}</a></p>
</Layout>

<style>
  form {
    max-width: 24rem;
    display: grid;
    gap: 0.4rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    padding: 1.25rem;
  }
  label {
    font-size: 0.9rem;
    color: var(--muted);
  }
  input {
    padding: 0.5rem;
    border: 1px solid var(--line);
    border-radius: 0.3rem;
    font: inherit;
  }
  button {
    margin-top: 0.75rem;
    padding: 0.55rem;
    border: 0;
    border-radius: 0.3rem;
    background: var(--accent);
    color: white;
    font: inherit;
    cursor: pointer;
  }
  .error {
    margin: 0 0 0.5rem;
    color: #a11;
  }
  .notice {
    color: var(--muted);
    max-width: 32rem;
  }
</style>
