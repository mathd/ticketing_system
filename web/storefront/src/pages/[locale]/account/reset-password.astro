---
// Redeem a mailed reset link and choose a new password (TKT-226 / ADR-050).
//
// THE TOKEN ARRIVES IN THE QUERY AND LEAVES IN THE BODY. It is rendered into a hidden
// field and POSTed to a URL that carries no query at all — see the form's `action`,
// which is root-relative precisely so the token does not ride along a second time.
//
// It is never put in a path segment: shared/go/obs/requestlog.go logs the request path
// on every service and the gateway, so a token in the path would be written to a log
// the way guest_order_ref was until TKT-202. That fix does NOT make this safe to change:
// it sanitises *declared* capability route shapes (shared/go/obs/capability_path.go), so
// a token in an undeclared path is still logged in full. Moving a credential into a path
// means adding a row to that table — the query keeps it out of the question. The query
// string is not logged by THIS repo, which ADR-049 § TKT-222 already relies on — but the
// GET still carries it, so `Referrer-Policy: no-referrer` and `Cache-Control: no-store`
// below are what bound where that one request's URL can travel.
//
// A fragment (`#token=…`) would keep it off the wire entirely, and was rejected: a
// fragment is not sent to ANY server including ours, so the page would have to read
// `location.hash` in the browser — making password recovery the one storefront path
// that requires JavaScript, for the buyer who is already locked out. The residual the
// fragment would have closed is Referer leakage, and `Referrer-Policy: no-referrer`
// below closes that directly.
//
// Anonymous by construction (gate.ts), for the same reason forgot-password is.
import Layout from '../../../layouts/Layout.astro';
import { completePasswordReset } from '../../../lib/customer-api';
import { sessionStore } from '../../../lib/session';
import { UI_STRINGS, isLocale } from '../../../lib/locales';

const locale = Astro.params.locale;
if (!locale || !isLocale(locale)) return new Response('Not found', { status: 404 });
const t = UI_STRINGS[locale];

// Referrer-Policy `origin`, and it is NOT `no-referrer` — which is what this was first
// written as, and which broke the whole feature.
//
// `no-referrer` makes Chrome send `Origin: null` on a form POST from this page. gate.ts
// compares Origin against the gateway's public origin and refuses anything else, so every
// reset completion was answered 403 before the handler ran. Verified in a browser:
// forgot-password POSTed `origin="http://localhost:18099"` and got 200, this page POSTed
// `origin="null"` and got 403. `make check` renders storefront pages and never submits
// one, so nothing in the gate could see it — the exact class AGENTS.md and ADR-049 §6
// describe, arriving for the third time (TKT-105, TKT-220, here).
//
// `origin` keeps the Origin header intact and still strips the path and query from the
// Referer — so the token never appears in a referrer, same-origin or cross-origin, which
// is more than `same-origin` would give and is the residual the rejected URL-fragment
// design was meant to cover.
Astro.response.headers.set('Referrer-Policy', 'origin');
// The URL carries a live credential; it must not sit in a shared cache.
Astro.response.headers.set('Cache-Control', 'no-store');

// The form posts to a ROOT-RELATIVE path, not to `action=""` as every other form in this
// app does (ai-review [high]).
//
// An empty action resolves to the DOCUMENT's URL, query string included, so the POST
// would go to `/en/account/reset-password?token=...` and put the token straight back into
// a request URL — the thing this page is arranged to avoid. Copying it into the hidden
// field does not remove it from the URL; it adds a second copy. A bare relative segment
// would strip the query too, but resolves differently under a trailing slash.
//
// TKT-105's absolute-action trap does not apply: that trap is Astro's
// `security.checkOrigin`, which astro.config.mjs sets to FALSE (ADR-049 §6), and the
// check that replaced it reads the `Origin` HEADER — which a form's action does not
// influence. This value carries no scheme and no host.
const formAction = `/${locale}/account/reset-password`;

// On GET the token comes from the query; on POST from the hidden field. Reading the
// query on POST too would let a stale URL override what the buyer submitted.
let token =
  Astro.request.method === 'POST' ? '' : (Astro.url.searchParams.get('token') ?? '');
let error: string | null = null;
let done = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  token = String(form.get('token') ?? '');
  const password = String(form.get('password') ?? '');

  if (!token) {
    error = t.resetLinkDead;
  } else if (!password) {
    error = t.passwordMinimum;
  } else {
    const result = await completePasswordReset(token, password);
    if (result.ok) {
      // THE HALF THAT MAKES A RESET MEAN ANYTHING. Changing the credential does not
      // touch the session map — it never re-checks a password — so an attacker
      // holding a stolen live session would keep it. This is what signs them out.
      //
      // It works because sessions live in THIS process (ADR-049 §4). A reset
      // completed by calling commerce directly never reaches this line, and ADR-050
      // names that as an open gap rather than pretending otherwise.
      sessionStore.destroyAllForCustomer(result.customerId);
      done = true;
      token = '';
    } else if (result.reason === 'invalid') {
      // The token is still good — only the password was refused. Keeping the buyer on
      // this form with their token intact is the difference between a retry and a
      // trip back to a mailbox for a link they already used.
      error = t.passwordMinimum;
    } else if (result.reason === 'refused') {
      error = t.resetLinkDead;
      token = '';
    } else if (result.reason === 'throttled') {
      // The token is deliberately KEPT (unlike the `refused` branch above): it is
      // still valid, the request was only too fast, and clearing it would send a
      // buyer back to their mailbox for a link they are already holding.
      error = t.tooManyAttempts;
    } else {
      error = t.accountUnavailable;
    }
  }
}
---

<Layout locale={locale} title={t.chooseNewPassword}>
  <h1>{t.chooseNewPassword}</h1>
  {
    done ? (
      <>
        <p class="notice" role="status">{t.resetDone}</p>
        <p class="notice">{t.resetSignedOutEverywhere}</p>
        <p><a href={`/${locale}/account/sign-in`}>{t.signIn}</a></p>
      </>
    ) : token ? (
      <form method="post" action={formAction}>
        {error && <p class="error" role="alert">{error}</p>}
        <input type="hidden" name="token" value={token} />
        <label for="password">{t.newPassword}</label>
        <input
          id="password"
          name="password"
          type="password"
          autocomplete="new-password"
          minlength="8"
          required
        />
        <p class="hint">{t.passwordMinimum}</p>
        <button type="submit">{t.setNewPassword}</button>
      </form>
    ) : (
      <>
        <p class="error" role="alert">{error ?? t.resetLinkDead}</p>
        <p><a href={`/${locale}/account/forgot-password`}>{t.forgotPasswordCta}</a></p>
      </>
    )
  }
</Layout>

<style>
  form {
    max-width: 24rem;
    display: grid;
    gap: 0.4rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    padding: 1.25rem;
  }
  label {
    font-size: 0.9rem;
    color: var(--muted);
  }
  input {
    padding: 0.5rem;
    border: 1px solid var(--line);
    border-radius: 0.3rem;
    font: inherit;
  }
  button {
    margin-top: 0.75rem;
    padding: 0.55rem;
    border: 0;
    border-radius: 0.3rem;
    background: var(--accent);
    color: white;
    font: inherit;
    cursor: pointer;
  }
  .error {
    margin: 0 0 0.5rem;
    color: #a11;
  }
  .hint,
  .notice {
    color: var(--muted);
    max-width: 32rem;
  }
  .hint {
    font-size: 0.85rem;
    margin: 0;
  }
</style>
