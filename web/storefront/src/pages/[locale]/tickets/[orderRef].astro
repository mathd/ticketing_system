---
import Layout from '../../../layouts/Layout.astro';
import { isLocale, UI_STRINGS } from '../../../lib/locales';
import { SESSION_COOKIE, sessionStore } from '../../../lib/session';
import { getTicketBundle, ticketsForDisplay } from '../../../lib/ticket-api';

const locale = Astro.params.locale;
if (!locale || !isLocale(locale)) return new Response('Not found', { status: 404 });
const orderRef = Astro.params.orderRef;
if (!orderRef) return new Response('Not found', { status: 404 });
const read = await getTicketBundle(orderRef);
if (!read.ok) {
  // Absent versus broken (TKT-305). `read.status` was already correct — getTicketBundle
  // answers 503 for a timeout or an exhausted issuance wait — but the BODY was the
  // 'Not found' literal on every branch, so a buyer mid-outage read that their tickets
  // do not exist. They do; access could not be reached. Same split, same wording as the
  // festival page, which is where this convention already lives.
  if (read.status === 404) return new Response('Not found', { status: 404 });
  return new Response('Service unavailable', { status: read.status });
}
const bundle = read.value;
const t = UI_STRINGS[locale];

// A ticket the buyer no longer holds must not be handed to them as a scannable code
// (TKT-166 ai-review F2). It was already wrong for a refund; an EXCHANGE makes it acute,
// because the replacement tickets deliberately share the source order's link, so the dead
// and the live credentials sit side by side under one reference. Rendering four identical
// numbered QRs and letting the buyer discover at the gate which two work is not a
// presentation detail.
//
// The verdict comes from the history the bundle already carries — no contract change, and
// no second source of truth about what is valid. The gate remains the authority; this only
// stops the page contradicting it.
const VOIDING = { exchanged: t.ticketVoidedExchanged, refunded: t.ticketVoidedRefunded } as const;
const voidedReason = (history: Array<{ type: string }>) => {
  for (const event of history) {
    const reason = VOIDING[event.type as keyof typeof VOIDING];
    if (reason) return reason;
  }
  return undefined;
};
// TKT-223: the claim form, shown only when this browser has a live session.
//
// The page stays PUBLIC — `requiresSession` is unchanged and guest retrieval must
// keep working, which is most of this page's traffic. It simply looks the session
// up itself, and does nothing when there is none. The cookie reaches here because
// TKT-220 scoped it to `/` rather than an account subtree (ADR-049 §5), which is
// exactly the case that decision was made for.
//
// Nothing about the session is rendered: no address, no principal, and above all
// no assertion. The form carries the order reference — which is already in the URL
// the buyer is looking at — and the locale.
const signedIn = Boolean(sessionStore.lookup(Astro.cookies.get(SESSION_COOKIE)?.value ?? ''));
const claimOutcome = Astro.url.searchParams.get('claim');
const claimMessage =
  claimOutcome === 'refused'
    ? t.claimRefused
    : claimOutcome === 'unavailable'
      ? t.claimUnavailable
      : null;

Astro.response.headers.set('Cache-Control', 'no-store');
---

<Layout locale={locale} title={t.myTickets}>
  <h1>{t.myTickets}</h1>
  <p>{t.ticketDeliveryNotice}</p>

  {claimMessage && <p class="claim claim--error" role="alert">{claimMessage}</p>}

  {
    signedIn ? (
      <form class="claim" method="post" action="/claim">
        <h2>{t.claimTitle}</h2>
        <p>{t.claimBody}</p>
        <input type="hidden" name="guest_order_ref" value={orderRef} />
        <input type="hidden" name="locale" value={locale} />
        <button type="submit">{t.claimAction}</button>
      </form>
    ) : (
      <p class="claim">
        <a href={`/${locale}/account/sign-in`}>{t.claimSignedOut}</a>
      </p>
    )
  }
  {/*
    Renders ticketsForDisplay(...), not the wire objects: this file is NOT
    typechecked (tsc does not parse .astro and the repo has no @astrojs/check),
    so a field read here is unchecked and a renamed contract field would ship
    an <img src={undefined}> past a fully green gate. The projection reads every
    field in checked TypeScript, where the rename breaks the build (TKT-303
    ai-review [medium]).
  */}
  {ticketsForDisplay(bundle).map((ticket, index) => {
    const voided = voidedReason(ticket.history);
    return (
      <article class={voided ? 'ticket ticket--voided' : 'ticket'}>
        <h2>{t.ticket} {index + 1}</h2>
        {voided ? (
          <p class="voided" role="status"><strong>{t.ticketVoided}</strong><br />{voided}</p>
        ) : (
          <img src={ticket.qrUrl} width="256" height="256" alt={t.ticketQrAlt} />
        )}
        <ul aria-label={t.ticketHistory}>
          {ticket.history.map((event) => <li>{event.type} — {new Date(event.occurredAt).toLocaleString(locale)}</li>)}
        </ul>
      </article>
    );
  })}
</Layout>

<style>
  .ticket { background: var(--card); border: 1px solid var(--line); border-radius: .5rem; margin: 1rem 0; padding: 1rem; }
  img { display: block; background: white; max-width: 100%; }
  .ticket--voided { opacity: .72; }
  .voided { border-left: 3px solid var(--line); margin: 0 0 .75rem; padding-left: .75rem; }
  .claim { background: var(--card); border: 1px solid var(--line); border-radius: .5rem; padding: 1rem 1.25rem; margin: 1rem 0; }
  .claim h2 { margin: 0 0 .25rem; font-size: 1.02rem; }
  .claim p { margin: 0 0 .75rem; color: var(--muted); }
  .claim--error { border-left: 3px solid #a11; }
  .claim button { padding: .5rem .9rem; border: 0; border-radius: .3rem; background: var(--accent); color: #fff; font: inherit; cursor: pointer; }
</style>
