# Smoke-only packaging image: runs the host-built dist (make build-ts)
# instead of running pnpm install + astro build inside Docker. The hermetic
# build stays in web/storefront/Dockerfile. Build context = repo root.
FROM node:26.5.1-alpine3.23@sha256:2a633e101381371ba148c7c212bf447c00cd267d814b708a9fe52c4984204729
ENV HOST=0.0.0.0 PORT=8080 NODE_ENV=production
WORKDIR /app
COPY web/storefront/dist ./dist
EXPOSE 8080
USER node
CMD ["node", "dist/server/entry.mjs"]
