---
// The slot channel-allocation editor (TKT-244 / US-CH2b): how much of a slot's capacity
// each sales channel may sell, and until when.
//
// ONE FORM, ONE SAVE. `PUT /internal/slots/{id}/channel-allocations` replaces the slot's
// COMPLETE allocation set atomically under the pool lock (ADR-024), so per-row saves are
// not merely unidiomatic here — they would round-trip a stale set and silently delete
// every allocation the operator was not looking at. Every row the page read is submitted
// on every save, including rows nobody touched.
//
// THAT SAME PROPERTY MAKES UNRENDERED FIELDS DANGEROUS. The store DELETEs and re-INSERTs
// from what arrives, so a field this page does not carry is a field the save destroys.
// `sold_by` is the one that matters: TKT-246 judges it in the claim paths under the pool
// row lock, so dropping it turns a reseller's bound stock into public stock — an
// authorization change, invisible in a screenshot.
//
// Those fields are NOT round-tripped through the client. The page re-reads inventory's
// current set on every request and the write takes them from there, matched on the exact
// channel code; a row naming a code inventory does not hold is REFUSED rather than
// treated as new. Three review passes converged on that: carrying the values in hidden
// inputs let a crafted POST choose them, and so did falling back to form values when the
// client-supplied channel key matched nothing. A field the form cannot submit cannot be
// forged. allocation-form.ts owns that mapping and its tests.
//
// The organizer comes from the SESSION, never the URL: inventory authenticates this
// process, not the staff member behind it (ADR-021/ADR-053), so it cannot tell a
// legitimate organizer from one typed into the address bar. That check has to live here
// to live anywhere. The slot id is a path parameter and is passed through — it is not an
// authorization boundary, and inventory scopes the read and the write by organizer.
//
// Relative form action, like every other back-office write: an absolute one trips the
// origin handling even same-origin (TKT-105; `checkOrigin` is off and gate.ts is
// authoritative).
import Layout from '../../layouts/Layout.astro';
import {
  type AllocationFormErrors,
  type AllocationRow,
  allocationErrors,
  parseAllocationForm,
  parseAllocationRevision,
  toAllocationRequest,
  toMinuteInput,
  MissingAllocationChannel,
  UnknownAllocationChannel,
  UnzonedReleaseTime,
  BlankedReleaseTime,
} from '../../lib/allocation-form';
import { type Channel, listChannelsForOperator } from '../../lib/catalog';
import {
  type ChannelAvailability,
  InventoryApiError,
  type StaffAvailability,
  getStaffAvailability,
  replaceChannelAllocations,
} from '../../lib/inventory';

const staff = Astro.locals.staff;
if (!staff) throw new Error('unauthenticated request reached the slot allocations page');

const slotId = Astro.params.id!;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const here = `${base}/slots/${encodeURIComponent(slotId)}`;

let errors: AllocationFormErrors = { rows: {} };
// Release-time refusals render beside the RELEASE input, not the cap input which
// `errors.rows` drives — putting a message about a timestamp under a number field
// is how an operator ends up editing the wrong thing (TKT-302 ai-review [high]).
let releaseErrors: Record<string, string> = {};
// The rows as submitted, so a refusal re-renders what the operator typed rather than
// discarding it back to the stored values.
let submitted: AllocationRow[] | null = null;
// The revision the submission carried, kept so a refusal re-renders THAT value rather
// than the current one (TKT-250). Re-rendering the fresh revision after a stale-write
// refusal would make the operator's second click succeed silently — the same lost update
// the refusal just prevented, one click later.
let submittedRevision: number | undefined;

// The read sits in its own error path: a service failure must render this page's readable
// message, not abort SSR into a 500 that says nothing.
//
// It runs BEFORE the write, because the write needs it (ai-review pass 2). A save must
// preserve the boundaries the operator did not touch, and the only trustworthy source for
// those is inventory itself — NOT a hidden input. Hidden fields are client-controlled and
// can be stale or forged, so treating them as evidence of stored state would let a crafted
// POST write an `opens_at`/`closes_at` this screen does not even expose for editing.
let availability: StaffAvailability | null = null;
let readFailed = false;
try {
  availability = await getStaffAvailability(slotId, staff.organizerId);
} catch {
  readFailed = true;
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const rows = parseAllocationForm(form);
  submitted = rows;
  // The revision the RENDERED PAGE carried — not the one the fresh read above just
  // returned (TKT-250). Sending the fresh one would compare inventory's current value
  // against itself and match every time; the precondition would be structurally
  // incapable of failing, which is worse than not having it, because the editor would
  // report protection it does not have.
  submittedRevision = parseAllocationRevision(form);

  // Presentation-only pre-checks. They never decide whether the write happens — the
  // server refuses regardless — they just keep a submit the server would reject anyway
  // from coming back as one opaque line.
  const local = allocationErrors(null, rows);
  if (Object.keys(local.rows).length > 0 || local.form) {
    errors = local;
  } else if (readFailed) {
    // Refusing is the only safe answer: without the current set this save could only
    // reconstruct the untouched fields from the form, which is the forgeable path above.
    errors = {
      rows: {},
      form: 'Inventory could not be read, so the change was not saved — the fields this screen does not show could not be preserved. Try again.',
    };
  } else if (submittedRevision === undefined) {
    // No revision, or an unparseable one. Refuse rather than fall back to an
    // unconditional replace: inventory would accept the omission from an internal
    // caller, but this process holds only the staff credential (ADR-057), so a
    // submission without one is malformed rather than privileged — and treating it as
    // "just save it" would reinstate exactly the lost update this ticket closes.
    errors = {
      rows: {},
      form: 'This form was submitted without its revision, so nothing was saved. Reload the page and try again.',
    };
  } else {
    try {
      await replaceChannelAllocations(
        slotId,
        toAllocationRequest(staff.organizerId, rows, availability?.channels ?? [], submittedRevision),
      );
      return Astro.redirect(here, 303);
    } catch (e) {
      if (e instanceof BlankedReleaseTime) {
        releaseErrors = {
          [e.channel]: 'To remove this release gate, tick “Remove this release gate”. Nothing was saved.',
        };
        errors = {
          rows: {},
          form: 'Nothing was saved. Clearing a release gate must be confirmed.',
        };
      } else if (e instanceof UnzonedReleaseTime) {
        // A row-level refusal, beside the field the operator must fix. NOTHING was
        // sent to inventory: returning early from toAllocationRequest is what stops
        // the full-set replace from clearing this channel's release gate, which is
        // what an omitted release_at would have done (ai-review [high]).
        releaseErrors = {
          [e.channel]:
            'Use RFC 3339 with a zone, e.g. 2026-09-18T19:30:00Z or 2026-09-18T15:30:00-04:00. ' +
            'At most six fractional-second digits.',
        };
        errors = {
          rows: {},
          form: 'Nothing was saved. One release time is not a zoned instant this form accepts.',
        };
      } else if (e instanceof UnknownAllocationChannel || e instanceof MissingAllocationChannel) {
        // The submitted set does not match this slot's current allocations — it names one
        // inventory does not hold, or omits one it does. Either the set changed while this
        // page was open, or the request did not come from this form. Either way the safe
        // answer is to refuse and re-read: this screen edits allocations, and creates and
        // deletes none, so an omission would be a silent deletion on the full-set replace.
        errors = {
          rows: {},
          form: `This slot’s allocations changed since this page was loaded, so nothing was saved (“${e.channel}”). Reload to see the current set.`,
        };
      } else if (e instanceof InventoryApiError) {
        errors = allocationErrors({ error: e.message, code: e.code, channel: e.channel }, rows);
      } else {
        errors = {
          rows: {},
          form: 'Inventory could not be reached. Nothing was saved — try again.',
        };
      }
    }
  }
}

// The registry is a LOOKUP, NOT A CONSTRAINT (TKT-235 / ADR-024): a channel code needs no
// registry row to sell, and codes recorded on live claims may name channels that were
// never registered. So a registry miss marks the row, and never hides or disables it.
let registered = new Set<string>();
try {
  registered = new Set((await listChannelsForOperator(staff.organizerAssertion)).map((c: Channel) => c.code));
} catch {
  // A registry outage costs the display names only. Editing must still work, so this is
  // deliberately not `readFailed`.
  registered = new Set();
}

const stored: ChannelAvailability[] = availability?.channels ?? [];

// The rendering and the "did the operator touch this?" comparison MUST agree, so both use
// the one formatter in allocation-form.ts. Two copies would drift, and the drift would
// read as an edit — silently truncating a boundary on an untouched field.
const localInput = toMinuteInput;

// What the form renders: the submitted rows after a refusal, otherwise the stored set.
const rows: AllocationRow[] =
  submitted ??
  stored.map((c) => ({
    channel: c.channel,
    cap: String(c.cap),
    releaseAt: localInput(c.release_at),
  }));

/** Live consumption for a row, by channel code — held plus confirmed. */
const consumption = new Map(stored.map((c) => [c.channel, { held: c.held, confirmed: c.confirmed }]));
---

<Layout title="Channel allocations">
  <h1>Channel allocations</h1>
  <p>
    How much of this slot's capacity each sales channel may sell. Everything not allocated
    stays available to the public channel.
  </p>

  {errors.form && <p class="error" role="alert" data-form-error>{errors.form}</p>}

  {readFailed && (
    <p class="error" role="alert">
      Inventory is unavailable, so this slot's allocations cannot be shown or edited.
    </p>
  )}

  {!readFailed && availability && (
    <>
      <p data-capacity={String(availability.capacity)}>
        Slot capacity <strong>{availability.capacity}</strong>, of which
        <strong> {availability.public_available}</strong> is currently available to the public.
      </p>

      {errors.total && <p class="error" role="alert" data-total-error>{errors.total}</p>}

      <form method="post" action="">
        {/* The allocation set's revision, compared by inventory under the pool lock
            (TKT-250). After a refusal this re-renders the SUBMITTED value, not the
            current one: re-rendering the fresh revision would let a second click apply
            the very stale set the refusal just stopped. */}
        <input
          type="hidden"
          name="allocationRevision"
          value={String(submittedRevision ?? availability?.allocation_revision ?? '')}
          data-allocation-revision
        />
        {rows.length === 0 && <p data-empty>No channel allocations — the whole slot sells publicly.</p>}

        {rows.length > 0 && (
          <table>
            <thead>
              <tr>
                <th>Channel</th>
                <th>Cap</th>
                <th>Sold or held</th>
                <th>Returns to public</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((row, i) => {
                const used = consumption.get(row.channel);
                const known = registered.has(row.channel);
                return (
                  <tr data-channel={row.channel} data-registered={String(known)}>
                    <td>
                      <code>{row.channel}</code>
                      {/* The registry is a lookup, not a constraint: an unregistered
                          code still sells and stays editable. Marked, never hidden. */}
                      {!known && (
                        <span data-unregistered title="No registry entry for this code">
                          {' '}— not in the channel registry
                        </span>
                      )}
                      {/* The channel code is the row's identity for the full-set
                          replace, and it is immutable here: renaming one would delete
                          an allocation and create another, silently discarding the
                          consumption recorded against the old code. */}
                      <input type="hidden" name={`channel.${i}`} value={row.channel} />
                      {/* The three fields this screen does not edit, carried so the
                          full-set replace does not destroy them. `requiresCode` is an
                          EXPLICIT 'true'/'false' — a hidden input always submits, so
                          the checkbox convention cannot apply here (TKT-236). */}
                      {/* Nothing else rides. The sales window, the presale gate and the
                          seller binding are not editable here, and a field the form does
                          not submit is a field a crafted POST cannot choose — inventory
                          validates none of them (ai-review pass 3). The write takes them
                          from inventory's current set, matched on this exact code. */}
                    </td>
                    <td>
                      <label class="visually-hidden" for={`cap-${i}`}>Cap for {row.channel}</label>
                      <input
                        id={`cap-${i}`}
                        name={`cap.${i}`}
                        type="number"
                        min="1"
                        value={row.cap}
                        data-cap-for={row.channel}
                        aria-invalid={errors.rows[row.channel] ? 'true' : undefined}
                        required
                      />
                      {errors.rows[row.channel] && (
                        <p class="error" role="alert" data-row-error={row.channel}>
                          {errors.rows[row.channel]}
                        </p>
                      )}
                    </td>
                    <td data-consumption={row.channel}>
                      {used ? used.held + used.confirmed : 0}
                    </td>
                    <td>
                      <label class="visually-hidden" for={`release-${i}`}>
                        Release time for {row.channel}
                      </label>
                      {/* RFC 3339 WITH a zone, not datetime-local (TKT-302).
                          A datetime-local value carries no zone, so the server
                          resolved it in ITS zone and an operator's edited
                          release time shifted by (server TZ - operator TZ) --
                          silently, with a 303 reporting success. Same shape and
                          same reason as events/new.astro's starts_at.

                          The value is rendered in UTC so the field says which
                          instant it means; an operator may type any offset. The
                          cost is the native picker, which is the trade
                          events/new.astro already made. */}
                      <input
                        id={`release-${i}`}
                        name={`releaseAt.${i}`}
                        type="text"
                        inputmode="text"
                        placeholder="2026-09-18T19:30:00Z"
                        {/* Must mirror parseZonedInstant's grammar. A stricter
                            pattern is not a harmless extra guard: the browser
                            blocks the submission, so a form the SERVER accepts
                            becomes unreachable through the UI and the unit tests
                            still pass because they bypass the form (ai-review
                            pass 4, [medium]). Case-insensitive T/Z and a
                            MICROSECOND-bounded fraction (six digits), exactly as
                            the server parses — PostgreSQL timestamptz stores
                            microseconds, so a value pasted back from the database
                            must be typable here.

                            THE HYPHEN IS ESCAPED, and that is load-bearing.
                            Browsers compile `pattern` with the RegExp `v` flag,
                            under which a bare `[+-]` is a reserved double-punctuator
                            and the whole regex FAILS TO COMPILE — so the attribute
                            is ignored and validates nothing. Verified in real
                            Chrome: `[+-]` gives checkValidity() === true for a value
                            it should reject, `[+\-]` gives false. The pattern this
                            replaced carried the bare form and had therefore never
                            enforced anything. */}
                        pattern="\d{4}-\d{2}-\d{2}[Tt]\d{2}:\d{2}(:\d{2}(\.\d{1,6})?)?([Zz]|[+\-]\d{2}:\d{2})"
                        title="RFC 3339 with a zone, e.g. 2026-09-18T19:30:00Z or 2026-09-18T15:30:00-04:00"
                        value={row.releaseAt}
                        data-release-for={row.channel}
                        aria-invalid={releaseErrors[row.channel] ? 'true' : undefined}
                      />
                      {/* Clearing a release gate is DESTRUCTIVE and asks for less
                          input than a malformed value, which the server refuses
                          outright (ai-review pass 2, [medium]). Blank-means-clear
                          predates this ticket — the datetime-local input behaved
                          the same way — but a free-text field makes an accidental
                          blank easier, so removal is now an explicit act rather
                          than the absence of one.

                          Checked-and-blank clears; blank alone is refused. This
                          is the checkbox convention (absent means false), and it
                          is a real checkbox rather than a hidden input, so absent
                          is reachable — the trap TKT-236 paid for.

                          Keyed on the STORED gate, not the submitted text. Keying it
                          on `row.releaseAt !== ''` hid the checkbox on exactly the
                          re-render that tells the operator to tick it: a blank
                          submission is refused, the page re-renders the SUBMITTED
                          blank, and the control vanishes — an error with no way to
                          act on it (ai-review pass 3, [medium]). */}
                      {stored.some((c) => c.channel === row.channel && c.release_at) && (
                        <label class="clear-release">
                          <input
                            type="checkbox"
                            name={`clearRelease.${i}`}
                            value="true"
                            data-clear-release-for={row.channel}
                          />
                          Remove this release gate
                        </label>
                      )}
                      {releaseErrors[row.channel] && (
                        <p class="error" role="alert" data-release-error={row.channel}>
                          {releaseErrors[row.channel]}
                        </p>
                      )}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        )}

        {rows.length > 0 && (
          <button type="submit" data-action="save-allocations">Save allocations</button>
        )}
      </form>
    </>
  )}
</Layout>
