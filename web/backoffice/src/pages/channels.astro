---
// The sales-channel registry admin (TKT-236 / US-CH2): define the channels this
// organizer sells through, and retire one without deleting it.
//
// One page, four actions (create, rename, enable/disable, review), no
// query-string state — the whole registry fits on one screen, so there is
// nothing to page through and nothing to carry across requests. Same idiom as events/new.astro and venues/[id].astro: `_action`
// dispatch, post/redirect/get on success, re-render with the error on failure,
// and RELATIVE form actions (an absolute one trips the origin handling even
// same-origin — TKT-105; `checkOrigin` is off and gate.ts is authoritative).
//
// The organizer comes from the SESSION on every read and every write. Never from
// the URL: catalog authenticates this process, not the staff member behind it
// (ADR-021), so it cannot tell a legitimate organizer from one typed into the
// address bar. That check has to live here to live anywhere.
//
// OPTIMISTIC TOKEN (TKT-325, ADR-080). Both row forms carry the row's revision
// as rendered, and catalog refuses a stale one with a coded 409. Without it, a
// rename from an open page re-enabled a channel another operator had just
// disabled, and a toggle reverted another operator's rename, both with a 303
// reporting success. Honest-writer lost-update protection, not authorization.
//
// DISABLE, NEVER DELETE. There is no delete endpoint by design (TKT-235): a code
// removed from the registry is still recorded on live claims, fee rules and
// split schedules, none of which reference this table — so a delete would orphan
// data silently. Disabling takes the channel out of the storefront selector and
// leaves everything else intact, which is why this page must both SHOW disabled
// channels and be able to re-enable them.
import Layout from '../layouts/Layout.astro';
import { AmbiguousMutationError } from '../lib/upstream';
import {
  CatalogApiError,
  type Channel,
  createChannel,
  listChannelsForOperator,
  updateChannel,
} from '../lib/catalog';
import {
  CHANNEL_KINDS,
  type ChannelFormErrors,
  INVALID_CHANNEL_REVISION_MESSAGE,
  asChannelKind,
  checkboxChecked,
  classifyCatalogError,
  hasErrors,
  parseChannelRevision,
  validateSubmission,
} from '../lib/channel-form';

const staff = Astro.locals.staff;
if (!staff) throw new Error('unauthenticated request reached the channels page');

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const here = `${base}/channels`;

let errors: ChannelFormErrors = { fields: {} };
let submitted: Record<string, string> = {};
let action = '';
// Which form the errors belong to. Without this every refusal renders against
// the CREATE form — so an overlong rename flagged the create field and copied
// the attempted name into it, sending the operator to edit the wrong input
// (ai-review). `null` on the create path; the channel id on a row action.
let failedChannelId: string | null = null;
// The optimistic token the refused form SUBMITTED, exactly as it arrived
// (TKT-325, ADR-080). The failed row renders it back on BOTH of its forms, so a
// second click is refused again. Rendering the fresh revision instead would let
// that second click apply the change the refusal just stopped (TKT-250).
let submittedToken = '';
// "Review current channel" (A8): the row to show fresh, and the name the
// operator tried, when the refused action was a rename.
let reviewChannelId: string | null = null;
let reviewName: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  action = String(form.get('_action') ?? '');
  const field = (name: string) => String(form.get(name) ?? '');
  submitted = Object.fromEntries([...form.entries()].map(([k, v]) => [k, String(v)]));

  try {
    if (action === 'create') {
      const input = { code: field('code'), displayName: field('display_name'), kind: field('kind') };
      const local = validateSubmission(input);
      if (hasErrors(local)) {
        errors = local;
      } else {
        // `enabled` is omitted when the box is checked so the contract's
        // `default: true` applies, and sent explicitly as false when it is not.
        // An unchecked checkbox submits NOTHING — see checkboxChecked.
        const enabled = checkboxChecked(form.get('enabled'));
        await createChannel(staff.organizerAssertion, staff.organizerId, {
          code: input.code,
          displayName: input.displayName,
          kind: asChannelKind(input.kind)!,
          ...(enabled ? {} : { enabled: false }),
        });
        return Astro.redirect(here, 303);
      }
    } else if (action === 'update' || action === 'set-enabled') {
      // Both row forms send a FULL replacement — the endpoint has no partial
      // update — so the row's code, name, kind and enabled flag ride along in
      // hidden fields taken from the rendered row (D6). What makes that safe is
      // the token beside them: catalog compares it under the row lock, and a
      // matching token means the stored row is the one this page rendered.
      //
      // The token is the SUBMITTED one, forwarded unchanged. This handler reads
      // nothing from catalog before the PUT: a token taken from a read made
      // while handling this request would be compared with itself and match
      // every time ("a precondition that cannot fail", TKT-250).
      failedChannelId = field('channel_id');
      submittedToken = field('expected_revision');
      const input = { code: field('code'), displayName: field('display_name'), kind: field('kind') };
      const expectedRevision = parseChannelRevision(form.get('expected_revision'));
      // The rename's name is validated locally; the toggle's name is a hidden
      // copy of the rendered row and is not the operator's input.
      const local = action === 'update' ? validateSubmission(input) : { fields: {} };
      if (hasErrors(local)) {
        errors = local;
      } else if (expectedRevision === undefined) {
        // Absent or malformed: no request. `Number('')` is 0, so a lenient
        // parse would match every never-edited channel (A2).
        errors = { fields: {}, form: INVALID_CHANNEL_REVISION_MESSAGE, review: true };
      } else {
        await updateChannel(staff.organizerAssertion, staff.organizerId, field('channel_id'), {
          code: input.code,
          displayName: input.displayName,
          kind: asChannelKind(input.kind)!,
          // A literal, not checkboxChecked: this comes from a HIDDEN input that
          // always submits, so "absent means false" does not apply and an empty
          // value would read as true. Only the create form has a real checkbox.
          // On the toggle form the value states which way the button goes.
          enabled: field('enabled') === 'true',
          expectedRevision,
        });
        return Astro.redirect(here, 303);
      }
    } else if (action === 'review') {
      // Read-only (A8): no token is read and updateChannel is not called. The
      // page below renders the row from the fresh read, with its fresh token,
      // so the operator sees the other change before deciding again.
      reviewChannelId = field('channel_id');
      reviewName = form.get('display_name') === null ? null : field('display_name');
    }
  } catch (e) {
    errors = e instanceof CatalogApiError
      ? classifyCatalogError(e.status, e.message, {
            code: String(submitted.code ?? ''),
            displayName: String(submitted.display_name ?? ''),
            kind: String(submitted.kind ?? ''),
          }, e.code)
      : e instanceof AmbiguousMutationError
        ? {
            fields: {},
            form: 'Catalog may have saved this channel change, but its response could not be verified. Reload and reconcile the channel list before retrying.',
          }
        : { fields: {}, form: 'Catalog could not be reached. The change was not saved — try again.' };
  }
}

// The read is inside its own error path: a catalog failure must render this
// page's readable message, not abort SSR into a 500 that says nothing.
let channels: Channel[] = [];
let readFailed = false;
try {
  channels = await listChannelsForOperator(staff.organizerAssertion, staff.organizerId);
} catch {
  readFailed = true;
}

// The create form is re-filled only from a refused CREATE. A row action or a
// review submits fields with the same names, and they must not land there.
const val = (name: string) => (action === 'create' ? (submitted[name] ?? '') : '');
// Create-form errors only. A row action's refusal belongs beside that row.
const fieldError = (name: 'code' | 'display_name' | 'kind') =>
  failedChannelId === null ? errors.fields[name] : undefined;
const rowFailed = (channelId: string) => failedChannelId === channelId && hasErrors(errors);
// The refusal for one row, whichever field it landed on — the row has a single
// editable input, so there is nowhere else for it to go.
const rowError = (channelId: string) =>
  rowFailed(channelId)
    ? (errors.fields.display_name ?? errors.fields.code ?? errors.fields.kind ?? errors.form)
    : undefined;
// The token a row's forms carry: the SUBMITTED one on a refused row, otherwise
// the revision of the row as read for this render.
const tokenFor = (channel: Channel) => (rowFailed(channel.id) ? submittedToken : String(channel.revision));
// The rename input. The attempted name is kept only when the refused action was
// a RENAME (A1), or when a review carries one back. After a refused toggle it
// shows the current name: the toggle's hidden name is the stale snapshot, and
// pre-filling it would let one habitual Rename click overwrite the other
// operator's rename.
const renameValue = (channel: Channel) => {
  if (rowFailed(channel.id) && action === 'update') return submitted.display_name ?? channel.display_name;
  if (reviewChannelId === channel.id && reviewName !== null) return reviewName;
  return channel.display_name;
};
// The review form carries the attempted name only after a refused rename.
const reviewCarriesName = (channelId: string) => rowFailed(channelId) && action === 'update';
---

<Layout title="Sales channels">
  <h1>Sales channels</h1>
  <p>
    A channel is how a sale reaches you — the website, the box office, a presale, a reseller.
    Channels carry their own prices, fees and capacity elsewhere; this page defines which exist.
  </p>

  {errors.form && (failedChannelId === null || readFailed) && <p class="error" role="alert">{errors.form}</p>}

  {readFailed && (
    <p class="error" role="alert">
      The channel list is unavailable, so existing channels cannot be shown or edited. Creating one
      may still work.
    </p>
  )}

  {!readFailed && channels.length === 0 && <p>No channels yet.</p>}

  {!readFailed && channels.length > 0 && (
    <table>
      <thead>
        <tr>
          <th>Code</th>
          <th>Display name</th>
          <th>Kind</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {channels.map((channel) => (
          <tr data-channel-code={channel.code} data-enabled={String(channel.enabled)}>
            {/* Read-only, and not an input: the code is immutable (TKT-235), and
                an editable box the server refuses is a worse affordance than
                text. A rename is a new channel plus disabling this one. */}
            <td><code>{channel.code}</code></td>
            <td>{channel.display_name}</td>
            <td>{channel.kind}</td>
            <td>
              <span data-status={channel.enabled ? 'enabled' : 'disabled'}>
                {channel.enabled ? 'Enabled' : 'Disabled'}
              </span>
            </td>
            <td>
              <form method="post" action="" data-form="toggle">
                <input type="hidden" name="_action" value="set-enabled" />
                <input type="hidden" name="channel_id" value={channel.id} />
                <input type="hidden" name="code" value={channel.code} />
                <input type="hidden" name="display_name" value={channel.display_name} />
                <input type="hidden" name="kind" value={channel.kind} />
                {/* The direction comes from the row as read for THIS render,
                    also after a refusal (A7): the button says what it will do
                    to the channel as it is now, not as it was. */}
                <input type="hidden" name="enabled" value={channel.enabled ? 'false' : 'true'} />
                {/* TKT-325: the optimistic token. See tokenFor. */}
                <input type="hidden" name="expected_revision" value={tokenFor(channel)} />
                <button type="submit" data-action={channel.enabled ? 'disable' : 'enable'}>
                  {channel.enabled ? 'Disable' : 'Enable'}
                </button>
              </form>
              <form method="post" action="" data-form="rename">
                <input type="hidden" name="_action" value="update" />
                <input type="hidden" name="channel_id" value={channel.id} />
                <input type="hidden" name="code" value={channel.code} />
                <input type="hidden" name="kind" value={channel.kind} />
                {/* An EXPLICIT boolean string, read by `field('enabled') === 'true'`
                    — never checkboxChecked. A hidden input always submits, so
                    the checkbox convention (absent means false) cannot apply:
                    `value=""` is present-and-empty, which checkboxChecked
                    correctly calls true, and a rename would re-enable a disabled
                    channel. Found at ai-review. */}
                <input type="hidden" name="enabled" value={String(channel.enabled)} />
                <input type="hidden" name="expected_revision" value={tokenFor(channel)} />
                <label for={`name-${channel.id}`}>Display name</label>
                <input
                  id={`name-${channel.id}`}
                  name="display_name"
                  value={renameValue(channel)}
                  data-rename-for={channel.code}
                  aria-invalid={rowError(channel.id) ? 'true' : undefined}
                  required
                />
                <button type="submit">Rename</button>
                {rowError(channel.id) && (
                  <p class="error" role="alert" data-row-error={channel.code}>{rowError(channel.id)}</p>
                )}
              </form>
              {rowFailed(channel.id) && errors.review && (
                // Recovery without a reload (D5, A8). A read, never a write:
                // the page renders this row fresh, with its fresh token, and
                // the operator decides again.
                <form method="post" action="" data-form="review">
                  <input type="hidden" name="_action" value="review" />
                  <input type="hidden" name="channel_id" value={channel.id} />
                  {reviewCarriesName(channel.id) && (
                    <input type="hidden" name="display_name" value={submitted.display_name ?? ''} />
                  )}
                  <button type="submit" data-review-for={channel.code}>Review current channel</button>
                </form>
              )}
              {reviewChannelId === channel.id && (
                <p data-row-review={channel.code}>
                  These are the channel's current values. Make your change again to save it.
                </p>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  )}

  <h2>Add a channel</h2>
  <form method="post" action="">
    <input type="hidden" name="_action" value="create" />

    <label for="code">Code</label>
    <input
      id="code"
      name="code"
      required
      value={val('code')}
      aria-invalid={fieldError('code') ? 'true' : undefined}
      aria-describedby={fieldError('code') ? 'code-error' : undefined}
    />
    {/* Beside the field, not in a banner: the operator has to know WHICH input
        to fix, and a single form-level line does not say. */}
    {fieldError('code') && <p class="error" id="code-error" role="alert">{fieldError('code')}</p>}
    <p>Exact and case-sensitive, and permanent. “POS” and “pos” are two channels.</p>

    <label for="display_name">Display name</label>
    <input
      id="display_name"
      name="display_name"
      required
      value={val('display_name')}
      aria-invalid={fieldError('display_name') ? 'true' : undefined}
      aria-describedby={fieldError('display_name') ? 'display-name-error' : undefined}
    />
    {fieldError('display_name') && (
      <p class="error" id="display-name-error" role="alert">{fieldError('display_name')}</p>
    )}

    <label for="kind">Kind</label>
    <select
      id="kind"
      name="kind"
      aria-invalid={fieldError('kind') ? 'true' : undefined}
      aria-describedby={fieldError('kind') ? 'kind-error' : undefined}
    >
      {CHANNEL_KINDS.map((kind) => (
        <option value={kind} selected={val('kind') === kind}>{kind}</option>
      ))}
    </select>
    {fieldError('kind') && <p class="error" id="kind-error" role="alert">{fieldError('kind')}</p>}

    <label for="enabled">
      <input id="enabled" type="checkbox" name="enabled" checked={action !== 'create' || submitted.enabled !== undefined} />
      Available for sale
    </label>

    <button type="submit">Add channel</button>
  </form>
</Layout>
