---
// The back-office venue list (US-018): staff see the organizer's venues and
// their GA capacity. SSR reads through the gateway (ADR-002 public contract);
// no seat-map logic — this renders venues that already exist. Served at /admin/.
import Layout from '../layouts/Layout.astro';
import { getVenues } from '../lib/catalog';
import { canAccessRoute } from '../lib/authorization';

// The organizer comes from the session now (TKT-190), not from a constant. The
// middleware guarantees a principal on every gated path, so an absent one here
// would mean the gate was bypassed — fail rather than fall back to a default
// tenant and quietly show one organizer's venues to another's staff.
const staff = Astro.locals.staff;
if (!staff) throw new Error('unauthenticated request reached the venue list');

const venues = await getVenues(staff.organizerId);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Hide what this role cannot reach — from the SAME matrix the gate enforces, so
// the two cannot disagree. This is presentation only: the gate refuses the URL
// whether or not the link is rendered, and TKT-197's tests prove that by asking
// for the hidden URL directly. A link is a courtesy, never a control.
const canAuthorSeatMaps = canAccessRoute(`${base}/venues/x`, staff.role);
const canCreateEvents = canAccessRoute(`${base}/events/new`, staff.role);
const canLookUpOrders = canAccessRoute(`${base}/orders`, staff.role);
---

<Layout title="Venues — Back-office">
  <table>
    <caption>Venues</caption>
    <thead>
      <tr>
        <th scope="col">Name</th>
        <th scope="col">GA capacity</th>
        <th scope="col">Seat maps</th>
      </tr>
    </thead>
    <tbody>
      {
        venues.map((v) => (
          <tr>
            <td>{v.name}</td>
            <td class="num">{v.ga_capacity.toLocaleString('en')}</td>
            <td>
              {canAuthorSeatMaps ? (
                <a href={`${base}/venues/${v.id}`}>Author seat maps</a>
              ) : (
                <span class="muted">—</span>
              )}
            </td>
          </tr>
        ))
      }
      {
        venues.length === 0 && (
          <tr>
            <td class="empty" colspan="3">
              No venues yet.
            </td>
          </tr>
        )
      }
    </tbody>
  </table>

  {canCreateEvents && (
    <p><a href={`${base}/events/new`}>Create an event</a></p>
  )}

  {canLookUpOrders && (
    <p><a href={`${base}/orders`}>Look up an order</a></p>
  )}

  <!-- A form, not a link: sign-out changes state, so it is a POST — and the
       middleware's origin check only guards unsafe methods. Relative action
       (TKT-105: an absolute one trips the origin handling even same-origin). -->
  <form method="post" action="logout" class="signout">
    <button type="submit">Sign out</button>
  </form>
</Layout>
