---
// The order console (TKT-193 / US-B4): look up an order and see what happened
// to its tickets, without a database console.
//
// POST for a READ, which is unusual and deliberate. The ticket reference is a
// `guest_order_ref` — ADR-012 makes it a CSPRNG UUIDv4 that is "a no-store guest
// retrieval capability", redeemable by anyone who holds it and authenticated by
// nothing. A query string puts a capability in browser history, in the Referer
// header, and in every proxy log between here and the screen. So it travels in
// the request body, and there is no bookmarkable result URL. That is the cost.
//
// Two identifiers, because commerce and access key orders differently and
// nothing public maps one to the other (see lib/order-console.ts). Both fields
// are optional; the page renders whichever half it can answer.
import Layout from '../layouts/Layout.astro';
import { loadOrderConsole, parseLookup, parseRefund, unresolvedRefund, type ConsoleView, type Lookup, type RefundInput } from '../lib/order-console';
import { refundOrder, type Refund } from '../lib/commerce';
import {
  clearUnresolvedRefund,
  noteUnresolvedRefund,
  unresolvedRefundFor,
} from '../lib/unresolved-refunds';
import { randomUUID } from 'node:crypto';

const staff = Astro.locals.staff;
if (!staff) throw new Error('unauthenticated request reached the order console');

// ADR-004's "never" tier. Order state and ticket lifecycle change underneath a
// cached copy, and a stale answer to "what happened to this ticket" is worse
// than no answer — a support agent would act on it.
Astro.response.headers.set('Cache-Control', 'no-store');

/**
 * What this request DID, and therefore what the page may say about it.
 *
 * One value rather than four flags: the four accreted one review round at a
 * time, and every combination they could express that is not one of these is a
 * state the page has no copy for. `ambiguous` lives inside the refusal it
 * qualifies because that is the only variant it means anything for.
 */
type Action =
  | { kind: 'none' }
  | { kind: 'lookup-refused'; message: string }
  | { kind: 'refunded'; refund: Refund }
  | { kind: 'refund-refused'; message: string; ambiguous: boolean };

let action: Action = { kind: 'none' };
let view: ConsoleView | null = null;
let lookedUp: Lookup = {};
// Echoed back so the agent can correct what they typed. Quantity and reason are
// cleared on a successful refund and kept otherwise.
let submitted = { order_id: '', ticket_ref: '', quantity: '', reason: '' };
// The refund still hanging over this order: commerce may have moved money and
// has not said so. While this is set the page offers only the retry, never a new
// refund. Null when there is nothing outstanding.
let unresolved: RefundInput | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const field = (name: string) => String(form.get(name) ?? '');
  const refunding = field('_action') === 'refund';
  submitted = {
    order_id: field('order_id'),
    ticket_ref: field('ticket_ref'),
    // Only the refund form carries these. Echoing them off a lookup would let a
    // hand-made lookup POST prefill the refund form it renders.
    quantity: refunding ? field('quantity') : '',
    reason: refunding ? field('reason') : '',
  };

  // 1. Apply the action, if there is one. Its outcome — and the key left
  //    outstanding on the order — belong to the refund alone; step 2 reloads
  //    the order beneath it and must overwrite neither.
  if (refunding) {
    const parsed = parseRefund(field);
    if (!parsed.ok) {
      action = { kind: 'refund-refused', message: parsed.message, ambiguous: false };
      // The key comes from the SERVER, never from the submitted form. Nothing
      // has reached commerce on this branch so no money is at stake, but an
      // order that already has an outstanding key must be offered the retry
      // rather than a fresh form — and browser-supplied provenance is not
      // evidence of which key that is (ai-review pass 4).
      unresolved = unresolvedRefundFor(staff.organizerId, submitted.order_id.trim()) ?? null;
    } else {
      const outcome = await refundOrder({
        orderId: parsed.value.orderId,
        quantity: parsed.value.quantity,
        reason: parsed.value.reason,
        idempotencyKey: parsed.value.idempotencyKey,
        // From the session, never the form (COS-5).
        actor: staff.staffId,
        organizerId: staff.organizerId,
      });
      // Provenance comes from the SERVER, never the browser. An earlier version
      // read a hidden `retry_of` field, which is not evidence of anything: a
      // forged or stale value could name a key other than the one that actually
      // became ambiguous, discarding the only replay-safe key there was
      // (ai-review pass 4).
      const outstanding = unresolvedRefundFor(staff.organizerId, parsed.value.orderId);
      if (outcome.ok) {
        action = { kind: 'refunded', refund: outcome.value };
        // Clear the prefill. Re-rendering the previous quantity and reason into
        // a freshly keyed form leaves a second refund one click away, on an
        // order that stays `completed` with quantity still refundable
        // (ai-review pass 3).
        submitted = { ...submitted, quantity: '', reason: '' };
      } else {
        action = {
          kind: 'refund-refused',
          message: outcome.message,
          ambiguous: outcome.kind === 'ambiguous',
        };
        Astro.response.status = outcome.kind === 'not-found' ? 404 : 200;
      }
      unresolved = unresolvedRefund(
        outcome,
        outstanding ?? parsed.value,
        outstanding?.idempotencyKey ?? null,
      );
      if (unresolved) {
        noteUnresolvedRefund(staff.organizerId, unresolved);
      } else {
        // Commerce told us what happened to this order's outstanding key.
        clearUnresolvedRefund(staff.organizerId, parsed.value.orderId);
      }
    }
  }

  // 2. Load the view, so the page shows what it is talking about either way.
  const lookup = parseLookup(submitted.order_id, submitted.ticket_ref);
  if (lookup.ok) {
    lookedUp = lookup.value;
    view = await loadOrderConsole(lookup.value);
    if (!refunding) {
      Astro.response.status = view.status;
      // A plain lookup must surface an outstanding refund too — otherwise the
      // simplest possible recovery from an ambiguous result ("look it up
      // again") is the one that offers a freshly keyed refund form.
      if (lookup.value.orderId) {
        unresolved = unresolvedRefundFor(staff.organizerId, lookup.value.orderId) ?? null;
      }
    }
  } else if (!refunding) {
    action = { kind: 'lookup-refused', message: lookup.message };
  }
}

/**
 * The one place that decides whether a NEW refund may be offered, and with what.
 *
 * There is a completed order to refund and nothing outstanding on it — while
 * something is outstanding the page offers the retry and only the retry. The
 * key is minted HERE, which is what "per rendered form" means: two concurrent
 * submits of this form carry the same key and commerce replays the second,
 * while a deliberate second refund gets a new form and a new key.
 */
const refundForm =
  view?.order?.ok === true && view.order.value.status === 'completed' && !unresolved
    ? { idempotencyKey: randomUUID(), quantity: submitted.quantity, reason: submitted.reason }
    : null;
---

<Layout title="Look up an order — Back-office">
  <h1>Look up an order</h1>

  <!-- COS-6: say what this view leaves out, rather than rendering empty Buyer
       and Total sections. Blank fields read as broken data; this reads as a
       scoped tool. The missing reads are TKT-201's. -->
  <section class="scope">
    <h2>What this view shows</h2>
    <p>
      An order's status, and each ticket's lifecycle history. It does not show buyer contact,
      line items, or any money — the back office has no read for those, so they are absent by
      design rather than missing.
    </p>
  </section>

  {action.kind === 'lookup-refused' && <p class="error" role="alert">{action.message}</p>}

  <form method="post" action="">
    <input type="hidden" name="_action" value="lookup" />
    <p class="muted">
      Enter either identifier. The order id appears in internal reports; the ticket reference is
      the one in the customer's ticket link.
    </p>
    <label for="order_id">Order id</label>
    <input id="order_id" name="order_id" value={submitted.order_id} autocomplete="off" />
    <label for="ticket_ref">Ticket reference</label>
    <input id="ticket_ref" name="ticket_ref" value={submitted.ticket_ref} autocomplete="off" />
    <button type="submit">Look it up</button>
  </form>

  {view && (
    <section class="result">
      {/* Two lookups, never one order. Nothing correlates an order id with a
          ticket reference — that is the whole reason this page takes both — so
          rendering them under one heading would let an operator read one
          order's status above another order's ticket history and act on it.
          Each half names the identifier it came from, and when both are present
          the page says plainly that it cannot vouch for the pairing. */}
      {view.order && view.tickets && (
        <p class="caveat">
          These are two independent lookups. Nothing links an order id to a ticket reference, so
          this page cannot confirm that the two below belong to the same order.
        </p>
      )}

      <h2>Order status{view.order && <span class="muted"> — {lookedUp.orderId}</span>}</h2>
      {view.order === undefined && <p class="muted">No order id was supplied.</p>}
      {view.order?.ok && (
        /* Commerce's own word for it. Not translated into "paid" or "valid" —
           those are claims this page has no read to support. */
        <p>Commerce reports this order as <strong>{view.order.value.status}</strong>.</p>
      )}
      {view.order?.ok === false && view.order.kind === 'not-found' && (
        <p>No order matched that order id.</p>
      )}
      {view.order?.ok === false && view.order.kind === 'unavailable' && (
        /* Never "not found": commerce has not established that the order is
           absent, only that it could not answer. */
        <p class="error">Commerce could not answer just now, so the status is unknown. Try again shortly.</p>
      )}

      <h2>Tickets{view.tickets && <span class="muted"> — reference {lookedUp.ref}</span>}</h2>
      {view.tickets === undefined && <p class="muted">No ticket reference was supplied.</p>}
      {view.tickets?.ok === false && view.tickets.kind === 'not-found' && (
        /* Issuance is asynchronous, so a very recent order legitimately has no
           tickets yet — which is not the same as the reference being wrong. */
        <p>No tickets matched that reference. A very recent order may not have been issued yet.</p>
      )}
      {view.tickets?.ok === false && view.tickets.kind === 'unavailable' && (
        <p class="error">Access could not answer just now, so the ticket history is unknown.</p>
      )}
      {view.tickets?.ok && view.tickets.value.map((t) => (
        <article class="ticket">
          <h3>Ticket {t.ticketId}</h3>
          <p class="muted">Issued {t.issuedAt}</p>
          <ol>
            {t.history.map((e) => (
              <li>
                <strong>{e.type}</strong> — {e.occurredAt}
                {e.sequence === undefined
                  ? <span class="muted"> (legacy event — no chain sequence)</span>
                  : <span class="muted"> (#{e.sequence})</span>}
              </li>
            ))}
          </ol>
          {t.history.length === 0 && <p class="muted">No lifecycle events recorded yet.</p>}
        </article>
      ))}
    </section>
  )}

  {(action.kind === 'refunded' || action.kind === 'refund-refused') && (
    <section class="refund-result">
      <h2>Refund</h2>
      {action.kind === 'refunded' && (
      <>
        {/* Commerce's OWN response, field by field. Never synthesized from what
            was submitted: the quantity commerce refunded is the one it reports,
            and on a replay it is the ORIGINAL refund's. */}
        <p>
          Commerce refunded <strong>{action.refund.quantity}</strong> ticket(s) —
          <strong> {action.refund.amount} {action.refund.currency}</strong> in minor units.
        </p>
        <p>
          This order is now <strong>{action.refund.refundStatus}</strong> refunded:
          {' '}{action.refund.refundedQuantity} ticket(s), {action.refund.refundedAmount}
          {' '}{action.refund.currency} in minor units, in total.
        </p>
        <p class="muted">Refund {action.refund.refundId}</p>
        {action.refund.replay && (
          /* A replay is the SAME refund answered again, not a second one — which
             is what the idempotency key buys. Saying so stops an operator
             refunding again because the first "did not seem to work". */
          <p>This was a replay of a refund already recorded. No additional money moved.</p>
        )}
        {!action.refund.ticketsVoided && (
          /* ADR-037/TKT-157: the money leg and the ticket leg are separate. False
             means the tickets are STILL VALID AT THE GATE. Saying nothing here
             would let staff tell a customer their ticket is dead when it will
             still scan. */
          <p class="error">
            The money was refunded but the tickets are <strong>not yet void</strong> — they may
            still scan at the gate. Commerce reports the reversal as outstanding.
          </p>
        )}
        {!action.refund.capacityReturned && (
          <p class="error">The refunded capacity has not been returned to inventory yet.</p>
        )}
      </>
      )}
      {action.kind === 'refund-refused' && (
        <p class="error" role="alert">
          {action.message}
          {action.ambiguous && (
            /* Never "no refund happened": commerce may have applied it. The key
               below is preserved, so resubmitting is a replay. */
            <> This refund may or may not have been applied. Submit the same request again — it
            will replay rather than refund twice.</>
          )}
        </p>
      )}
    </section>
  )}

  {unresolved && (
    /* Rendered from the REQUEST, not from a reloaded order: the outage that lost
       the response may also have taken the read. Same key, same quantity, same
       reason — so submitting this is a replay commerce recognises, never a
       second refund. */
    <form method="post" action="" class="refund">
      <input type="hidden" name="_action" value="refund" />
      <input type="hidden" name="order_id" value={unresolved.orderId} />
      <input type="hidden" name="ticket_ref" value={submitted.ticket_ref} />
      <input type="hidden" name="idempotency_key" value={unresolved.idempotencyKey} />
      <input type="hidden" name="quantity" value={String(unresolved.quantity)} />
      <input type="hidden" name="reason" value={unresolved.reason} />
      <h2>Retry this refund</h2>
      <p>
        Submitting this again replays the same request — commerce will return the original
        refund rather than making a second one. Do not start a new refund for this order until
        this has been resolved.
      </p>
      <button type="submit">Retry the same refund</button>
    </form>
  )}

  {refundForm && (
    <form method="post" action="" class="refund">
      <input type="hidden" name="_action" value="refund" />
      <input type="hidden" name="order_id" value={lookedUp.orderId} />
      <input type="hidden" name="ticket_ref" value={lookedUp.ref ?? ''} />
      <input type="hidden" name="idempotency_key" value={refundForm.idempotencyKey} />
      <h2>Refund this order</h2>
      <p class="muted">
        Refunds the money for the number of tickets given. The order stays <em>completed</em> —
        a refunded purchase is still a purchase that happened.
      </p>
      <label for="quantity">Tickets to refund</label>
      <input id="quantity" name="quantity" required inputmode="numeric" pattern="[0-9]+"
             value={refundForm.quantity} />
      <label for="reason">Reason</label>
      <input id="reason" name="reason" required maxlength="500" value={refundForm.reason} />
      <button type="submit">Refund</button>
    </form>
  )}

  <p><a href={import.meta.env.BASE_URL.replace(/\/$/, '')}>Back to venues</a></p>
</Layout>

<style>
  form { max-width: 30rem; display: grid; gap: 0.4rem; margin-bottom: 1.5rem; }
  .error { color: #a8322d; }
  .muted { color: var(--muted); }
  .scope { border-left: 3px solid var(--muted); padding-left: 0.8rem; margin-bottom: 1.5rem; }
  .caveat { border-left: 3px solid #a8322d; padding-left: 0.8rem; }
  .refund { max-width: 30rem; }
  .refund-result { border-left: 3px solid var(--accent); padding-left: 0.8rem; margin: 1.5rem 0; }
  .ticket { border-top: 1px solid var(--muted); padding-top: 0.5rem; margin-top: 1rem; }
</style>
