# Smoke-only packaging image: runs the host-built dist (make build-ts) instead
# of running pnpm install + astro build inside Docker. The hermetic build stays
# in web/backoffice/Dockerfile. Build context = repo root.
FROM node:26.13.1-alpine3.24@sha256:6bd9ab43c0ec0190ca7b2d193906cb8b7edf6e7f4afa43ddeccd6452710bffb5
ENV HOST=0.0.0.0 PORT=8080 NODE_ENV=production
WORKDIR /app
COPY web/backoffice/dist ./dist
COPY web/backoffice/start.mjs web/backoffice/credentials.mjs ./
EXPOSE 8080
USER node
# start.mjs, not entry.mjs: it refuses to start when the two staff credentials
# are missing or identical, BEFORE the server listens (TKT-194). Astro defers
# middleware to the first request, so a check there cannot fail the process.
CMD ["node", "start.mjs"]
